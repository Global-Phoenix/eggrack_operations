{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "OrdersConnection": "",
    "EggrackConnection": ""
  },
  "Database": {
    "SqlServer": {
      "Connections": {
        "Orders": {
          "Enabled": true,
          "ConnectionStringName": "OrdersConnection",
          "CommandTimeoutSeconds": 300
        }
      }
    },
    "MySql": {
      "Connections": {
        "Eggrack": {
          "Enabled": true,
          "ConnectionStringName": "EggrackConnection",
          "CommandTimeoutSeconds": 60
        }
      }
    }
  },
  "FileCenter": {
    "PlanUploadRoot": "App_Data/file-center/plans",
    "PublicBaseUrl": "https://test.eggracks.com/"
  }
}
