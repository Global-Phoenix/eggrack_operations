<div class="fc-large-preview" data-large-preview hidden role="dialog" aria-modal="true" aria-labelledby="largePreviewTitle">
    <button class="fc-large-backdrop" type="button" data-close-large aria-label="关闭大图预览"></button>
    <section class="fc-large-dialog" tabindex="-1">
        <header class="fc-large-toolbar">
            <div class="fc-large-title">
                <span class="fc-file-icon" data-large-icon><i class="bi bi-file-earmark"></i></span>
                <div><strong id="largePreviewTitle" data-large-name>文件预览</strong><small data-large-sub></small></div>
            </div>
            <div class="fc-large-tools">
                <div class="fc-large-gallery-tools" data-large-gallery-tools hidden>
                    <button class="fc-icon-button" type="button" data-large-previous disabled aria-label="上一张" title="上一张"><i class="bi bi-chevron-left"></i></button>
                    <span data-large-position></span>
                    <button class="fc-icon-button" type="button" data-large-next disabled aria-label="下一张" title="下一张"><i class="bi bi-chevron-right"></i></button>
                </div>
                <button class="btn btn-outline-secondary" type="button" data-large-new-window><i class="bi bi-box-arrow-up-right"></i><span>新窗口打开</span></button>
                <button class="btn btn-primary" type="button" data-large-download><i class="bi bi-download"></i><span>下载</span></button>
                <button class="fc-icon-button" type="button" data-close-large aria-label="关闭预览" title="关闭"><i class="bi bi-x-lg"></i></button>
            </div>
        </header>
        <div class="fc-large-body">
            <div class="fc-large-stage" data-large-stage></div>
            <aside class="fc-large-info">
                <div><span class="fc-section-label">文件信息</span><div data-large-meta></div></div>
                <button class="btn btn-outline-secondary w-100" type="button" data-large-business><i class="bi bi-box-arrow-up-right"></i> 打开关联业务</button>
            </aside>
        </div>
    </section>
</div>
