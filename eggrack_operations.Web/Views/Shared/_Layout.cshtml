<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EggRack Operations</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/workspace-tabs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/admin-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/workspace-components.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="admin-shell" id="adminShell">
    @await Component.InvokeAsync("Navigation")
    <div class="main-panel">
        @await Component.InvokeAsync("Topbar", new { title = ViewData["Title"]?.ToString() })
        @await Component.InvokeAsync("WorkspaceTabs", new { title = ViewData["Title"]?.ToString() })
        <main class="content-area"><div class="content-frame">@RenderBody()</div></main>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/js/common/app.js" asp-append-version="true"></script>
<script src="~/js/layout/shell.js" asp-append-version="true"></script>
<script src="~/js/layout/navigation.js" asp-append-version="true"></script>
<script src="~/js/layout/workspace-tabs.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
