@model ErrorViewModel
@{ Layout = "_AccountLayout"; ViewData["Title"] = "系统异常"; }
<div class="system-state-card">
    <span class="system-state-code">500</span><span class="system-state-icon"><i class="bi bi-exclamation-triangle"></i></span>
    <h1>系统暂时无法处理请求</h1><p>错误已记录，请稍后重试。若问题持续发生，请联系系统管理员。</p>
    @if (Model.ShowRequestId) { <small class="request-id">请求编号：@Model.RequestId</small> }
    <div class="d-flex gap-2 justify-content-center"><a class="btn btn-primary" href="/">返回工作台</a><button class="btn btn-outline-secondary" type="button" onclick="location.reload()">重新加载</button></div>
</div>