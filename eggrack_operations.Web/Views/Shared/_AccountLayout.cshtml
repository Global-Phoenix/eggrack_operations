<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Eggrack 运营管理中心</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>.system-state-card{padding:42px 34px;text-align:center;border:1px solid #e4e8ed;border-radius:10px;background:#fff;box-shadow:0 18px 50px #1f29370d}.system-state-code{display:block;color:#e7e9ed;font-size:70px;font-weight:800;line-height:1}.system-state-icon{width:54px;height:54px;margin:-18px auto 14px;display:grid;place-items:center;border-radius:50%;background:#fff4e5;color:#bd7920;font-size:24px}.system-state-card h1{font-size:20px}.system-state-card p{margin:9px auto 22px;color:#7f8997;font-size:12px;line-height:1.7}.request-id{display:block;margin:-10px 0 20px;color:#9aa3af}</style>
</head>
<body class="bg-body-tertiary">
<main class="container d-flex min-vh-100 align-items-center justify-content-center py-5">
    <div style="width:min(100%, 440px)">@RenderBody()</div>
</main>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
