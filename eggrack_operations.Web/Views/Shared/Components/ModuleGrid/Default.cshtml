@model IReadOnlyList<eggrack_operations.ViewComponents.ModuleCard>
<div class="module-grid">
    @foreach (var module in Model)
    {
        <a href="@module.Url" class="module-card">
            <span class="module-icon @module.Theme"><i class="bi @module.Icon"></i></span>
            <strong>@module.Title</strong><small>@module.Description</small>
        </a>
    }
</div>
