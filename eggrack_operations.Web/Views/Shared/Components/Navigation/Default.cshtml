@model eggrack_operations.ViewComponents.NavigationViewModel
<aside class="sidebar" id="sidebar">
    <a class="brand" asp-controller="Home" asp-action="Index" title="Eggracks 运营管理中心">
        <span class="brand-logo"><img src="~/favicon.ico" asp-append-version="true" alt="Eggracks" /></span>
        <span class="brand-copy"><strong>eggracks</strong><small>运营管理中心</small></span>
    </a>
    <nav class="sidebar-nav" aria-label="主导航">
        @foreach (var item in Model.Items)
        {
            if (item.Children is { Count: > 0 })
            {
                var groupActive = Model.IsGroupActive(item);
                <div class="nav-group @(groupActive ? "active" : string.Empty)">
                    <button class="nav-entry" type="button" aria-label="@item.Title">
                        <i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Title</span>
                    </button>
                    <div class="nav-flyout">
                        <div class="nav-flyout-title">@item.Title</div>
                        @foreach (var child in item.Children)
                        {
                            <a class="nav-flyout-link @(Model.IsActive(child) ? "active" : string.Empty)"
                               asp-area="@child.Area" asp-controller="@child.Controller" asp-action="@child.Action">
                                <i class="bi @child.Icon" aria-hidden="true"></i><span>@child.Title</span>
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <a class="nav-entry @(Model.IsActive(item) ? "active" : string.Empty)" title="@item.Title"
                   asp-area="@item.Area" asp-controller="@item.Controller" asp-action="@item.Action">
                    <i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Title</span>
                </a>
            }
        }
    </nav>
    <button class="sidebar-control" id="sidebarToggle" type="button" aria-label="切换导航">
        <i class="bi bi-layout-sidebar-inset" data-sidebar-icon></i><span>收起导航</span>
    </button>
</aside>
