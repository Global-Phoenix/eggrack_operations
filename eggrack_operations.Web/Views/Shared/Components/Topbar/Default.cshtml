@model eggrack_operations.ViewComponents.TopbarViewModel
<header class="topbar">
    <div class="d-flex align-items-center gap-3 min-w-0">
        <button class="mobile-menu" id="mobileMenu" type="button" aria-label="打开导航">☰</button>
        <div class="page-context"><strong>@Model.Title</strong><small>Eggrack Operations</small></div>
    </div>
    <div class="topbar-actions">
        <button class="topbar-button" type="button">任务 <span class="badge text-bg-warning">@Model.TaskCount</span></button>
        <button class="topbar-button" type="button">消息 <span class="badge text-bg-secondary">@Model.MessageCount</span></button>
        <div class="dropdown">
            <button class="user-button dropdown-toggle" data-bs-toggle="dropdown" type="button">
                <span class="avatar">@Model.DisplayName[..1]</span><span class="d-none d-sm-inline">@Model.DisplayName</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a class="dropdown-item" href="#">账号中心</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="#">退出登录</a></li>
            </ul>
        </div>
    </div>
</header>
