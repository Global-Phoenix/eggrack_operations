@model eggrack_operations.ViewComponents.TopbarViewModel
@{ var avatarText = string.IsNullOrWhiteSpace(Model.DisplayName) ? "用" : Model.DisplayName[..1]; }
<header class="topbar">
    <div class="topbar-main">
        <button class="mobile-menu top-tool" id="mobileMenu" type="button" aria-label="打开导航"><i class="bi bi-list"></i></button>
        <div class="topbar-section"><i class="bi bi-list-ul" aria-hidden="true"></i><span>@Model.Title</span></div>
        <label class="global-search" title="全局搜索将在后续阶段接入真实数据">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" placeholder="搜索申请、采购计划或文件" disabled aria-label="全局搜索，尚未开放">
        </label>
        <div class="topbar-actions">
            <div class="dropdown notification-dropdown">
                <button class="top-tool" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="通知中心" aria-label="通知中心"><i class="bi bi-bell"></i>@if (Model.MessageCount > 0) { <span class="notification-dot">@Model.MessageCount</span> }</button>
                <div class="dropdown-menu dropdown-menu-end notification-menu">
                    <div class="notification-title"><strong>通知中心</strong><small>暂无未读通知</small></div>
                    <div class="notification-empty"><i class="bi bi-bell-slash"></i><span>当前没有新的系统通知</span></div>
                </div>
            </div>
            <div class="dropdown">
                <button class="user-button dropdown-toggle" data-bs-toggle="dropdown" type="button" aria-expanded="false">
                    <span class="avatar">@avatarText</span><span class="user-name">@Model.DisplayName</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><h6 class="dropdown-header">@Model.DisplayName</h6></li>
                    <li><a class="dropdown-item" href="/account"><i class="bi bi-person"></i><span>账号中心</span></a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><form method="post" action="/account/logout" data-workspace-reset><button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right"></i><span>退出登录</span></button></form></li>
                </ul>
            </div>
        </div>
    </div>
</header>
