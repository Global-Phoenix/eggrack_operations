@model EnableAuthenticatorViewModel
@{ Layout = "_AccountLayout"; ViewData["Title"] = "设置双因素认证"; }
<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">
        <h1 class="h4">设置身份验证器</h1>
        <p class="text-secondary">首次登录必须绑定 TOTP。请在 Microsoft Authenticator、Google Authenticator 或其他兼容应用中手动输入密钥。</p>
        <div class="rounded bg-body-secondary p-3 mb-3">
            <div class="small text-secondary mb-1">设置密钥</div>
            <code class="fs-6 user-select-all">@Model.SharedKey</code>
        </div>
        <details class="mb-4">
            <summary class="small text-secondary">显示完整 otpauth 地址</summary>
            <code class="small text-break user-select-all">@Model.AuthenticatorUri</code>
        </details>
        <form method="post" asp-action="EnableAuthenticator">
            <input asp-for="SharedKey" type="hidden" />
            <input asp-for="AuthenticatorUri" type="hidden" />
            <label asp-for="Code" class="form-label">输入应用生成的验证码</label>
            <input asp-for="Code" class="form-control form-control-lg text-center font-monospace" inputmode="numeric" autocomplete="one-time-code" autofocus />
            <span asp-validation-for="Code" class="text-danger small"></span>
            <button class="btn btn-primary w-100 mt-4" type="submit">验证并启用</button>
        </form>
    </div>
</div>
