@model RecoveryCodesViewModel
@{ Layout = "_AccountLayout"; ViewData["Title"] = "保存恢复代码"; }
<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">
        <h1 class="h4">保存恢复代码</h1>
        <div class="alert alert-warning">每个恢复代码只能使用一次。请离线保存，不要截图上传或发送给他人。</div>
        <div class="row g-2 font-monospace mb-4">
            @foreach (var code in Model.Codes)
            {
                <div class="col-6"><div class="border rounded p-2 text-center user-select-all">@code</div></div>
            }
        </div>
        <a class="btn btn-primary w-100" href="~/">我已安全保存</a>
    </div>
</div>
