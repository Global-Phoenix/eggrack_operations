@{ ViewData["Title"] = "组件示例"; }

@await Component.InvokeAsync("PageHeader", new {
    title = "标准列表页",
    subtitle = "搜索、筛选、批量操作、分页、详情与表单交互的统一模板",
    parentTitle = "开发工具",
    parentUrl = "/UiKit",
    statusText = "前端演示数据",
    statusTone = "warning",
    primaryText = "新增记录",
    primaryUrl = "#recordModal"
})

<section class="ui-demo" data-ui-demo>
    <div class="ui-toolbar">
        <label class="ui-search"><i class="bi bi-search"></i><input class="form-control" type="search" data-search placeholder="搜索编号或名称" /></label>
        <select class="form-select ui-filter" data-status aria-label="状态筛选"><option value="">全部状态</option><option value="启用">启用</option><option value="停用">停用</option></select>
        <button class="btn btn-outline-secondary" type="button" data-reset><i class="bi bi-arrow-counterclockwise"></i> 重置</button>
        <span class="ui-toolbar-spacer"></span>
        <span class="ui-selection" data-selection>未选择记录</span>
        <button class="btn btn-outline-secondary" type="button" data-batch disabled>批量停用</button>
        <button class="btn btn-primary" type="button" data-create><i class="bi bi-plus-lg"></i> 新增</button>
    </div>

    <div class="ui-data-table">
        <table class="table table-hover align-middle">
            <thead><tr><th class="ui-check"><input class="form-check-input" type="checkbox" data-check-all aria-label="全选" /></th><th>编号</th><th>名称</th><th>分类</th><th>负责人</th><th>状态</th><th>更新时间</th><th class="text-end">操作</th></tr></thead>
            <tbody data-rows></tbody>
        </table>
        <div data-empty hidden>@await Component.InvokeAsync("EmptyState", new { title = "没有找到相关记录", description = "请调整关键词或筛选条件后重试", icon = "bi-search" })</div>
    </div>
    <div class="ui-pagination">
        <span data-result-summary></span>
        <div class="d-flex align-items-center gap-2"><button class="btn btn-sm btn-outline-secondary" type="button" data-prev>上一页</button><span data-page-summary></span><button class="btn btn-sm btn-outline-secondary" type="button" data-next>下一页</button></div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="recordDetail" aria-labelledby="recordDetailTitle">
        <div class="offcanvas-header border-bottom"><div><small class="text-secondary">记录详情</small><h5 class="offcanvas-title mt-1" id="recordDetailTitle" data-detail-title></h5></div><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
        <div class="offcanvas-body" data-detail-body></div>
        <div class="p-3 border-top"><button class="btn btn-primary w-100" type="button" data-edit-detail>编辑记录</button></div>
    </div>

    <div class="modal fade" id="recordModal" tabindex="-1" aria-labelledby="recordModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><form class="modal-content" data-form>
            <div class="modal-header"><h5 class="modal-title" id="recordModalTitle" data-form-title>新增记录</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" data-id />
                <div class="mb-3"><label class="form-label">名称</label><input class="form-control" data-name maxlength="60" required /><div class="invalid-feedback">请输入名称</div></div>
                <div class="mb-3"><label class="form-label">分类</label><select class="form-select" data-category required><option value="">请选择</option><option>采购</option><option>仓储</option><option>系统</option></select><div class="invalid-feedback">请选择分类</div></div>
                <div><label class="form-label">负责人</label><input class="form-control" data-owner maxlength="30" required /><div class="invalid-feedback">请输入负责人</div></div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存</button></div>
        </form></div>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3"><div class="toast" role="status" aria-live="polite" data-toast><div class="toast-body d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-success"></i><span data-toast-text></span></div></div></div>
</section>

@section Styles { <link rel="stylesheet" href="~/css/pages/ui-kit.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/ui-kit.js" asp-append-version="true"></script> }