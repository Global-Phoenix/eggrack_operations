@{
    ViewData["Title"] = "工作台";
}
<div class="dashboard-page">
@await Component.InvokeAsync("PageHeader", new { title = "运营工作台", subtitle = "批发业务与系统运营的统一入口", statusText = "系统运行正常", statusTone = "success" })
<div class="row g-3 mb-4 dashboard-metrics">
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric-card dashboard-metric"><span class="metric-icon blue"><i class="bi bi-check2-square"></i></span><div><span>待处理任务</span><strong>0</strong><small>任务中心</small></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric-card dashboard-metric"><span class="metric-icon purple"><i class="bi bi-cart3"></i></span><div><span>采购计划</span><strong>—</strong><small>由采购申请创建</small></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric-card dashboard-metric"><span class="metric-icon green"><i class="bi bi-folder2-open"></i></span><div><span>文件数量</span><strong>0</strong><small>文件中心</small></div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric-card dashboard-metric"><span class="metric-icon slate"><i class="bi bi-activity"></i></span><div><span>今日操作</span><strong>0</strong><small>日志中心</small></div></div></div>
</div>
<section class="dashboard-modules">
    <div class="dashboard-section-header"><div><h2>功能模块</h2><p>选择模块进入对应业务工作区</p></div><span><i class="bi bi-grid"></i> 快捷入口</span></div>
    <div class="dashboard-section-body">@await Component.InvokeAsync("ModuleGrid")</div>
</section>
</div>
@section Styles { <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" /> }