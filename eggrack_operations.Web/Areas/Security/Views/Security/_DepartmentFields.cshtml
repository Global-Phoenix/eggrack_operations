@model DepartmentFormViewModel
<div class="row g-3"><div class="col-6"><label class="form-label">部门编码</label><input class="form-control" name="Code" value="@Model.Code" required/></div><div class="col-6"><label class="form-label">排序</label><input class="form-control" name="SortOrder" type="number" value="@Model.SortOrder"/></div><div class="col-12"><label class="form-label">部门名称</label><input class="form-control" name="Name" value="@Model.Name" required/></div><div class="col-12"><label class="form-label">上级部门</label><select class="form-select" name="ParentId"><option value="">无上级部门</option>@foreach(var department in Model.Departments.Where(x=>x.Id!=Model.CurrentId)){<option value="@department.Id" selected="@(department.Id==Model.ParentId)">@department.Name</option>}</select></div></div>
