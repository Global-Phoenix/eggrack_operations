@model DepartmentIndexViewModel
@{ ViewData["Title"] = "部门管理"; }
@await Component.InvokeAsync("PageHeader", new { title = "部门管理", subtitle = "维护组织层级及权限数据范围", parentTitle = "权限管理", parentUrl = Url.Action("Index"), primaryText = "新增部门", primaryModalTarget = "#department-new", secondaryText = "返回概览", secondaryUrl = Url.Action("Index") })
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">部门</th><th>上级</th><th>人员</th><th>角色授权</th><th>状态</th><th class="text-end pe-4">操作</th></tr></thead><tbody>
@foreach(var item in Model.Departments){var modalId=$"department-{item.Id}";<tr><td class="ps-4"><strong>@item.Name</strong><div class="small text-secondary">@item.Code</div></td><td>@(item.ParentName??"—")</td><td>@item.StaffCount</td><td>@item.RoleCount</td><td><span class="badge @(item.IsEnabled?"text-bg-success":"text-bg-secondary")">@(item.IsEnabled?"启用":"停用")</span></td><td class="text-end pe-4"><div class="d-inline-flex gap-1"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#@modalId">编辑</button><form asp-action="SetDepartmentStatus" method="post"><input type="hidden" name="Id" value="@item.Id"/><input type="hidden" name="Enabled" value="@(!item.IsEnabled)"/><button class="btn btn-sm @(item.IsEnabled?"btn-outline-danger":"btn-outline-success")">@(item.IsEnabled?"停用":"启用")</button></form></div></td></tr>
<div class="modal fade" id="@modalId" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="SaveDepartment" method="post"><div class="modal-header"><h2 class="modal-title fs-5">编辑部门</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="Id" value="@item.Id"/><partial name="_DepartmentFields" model="@(new DepartmentFormViewModel(item.Code,item.Name,item.ParentId,item.SortOrder,Model.Departments,item.Id))" /></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary">保存</button></div></form></div></div></div>}
@if(Model.Departments.Count==0){<tr><td colspan="6" class="text-center text-secondary py-5">尚未创建部门</td></tr>}</tbody></table></div></div>
<div class="modal fade" id="department-new" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="SaveDepartment" method="post"><div class="modal-header"><h2 class="modal-title fs-5">新增部门</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><partial name="_DepartmentFields" model="@(new DepartmentFormViewModel("","",null,0,Model.Departments,null))" /></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary">创建</button></div></form></div></div></div>
@section Styles{<link rel="stylesheet" href="~/css/pages/security.css" asp-append-version="true"/>}
@section Scripts { <script src="~/js/pages/security-departments.js" asp-append-version="true"></script> }
