@model StaffIndexViewModel
@{ ViewData["Title"] = "人员权限"; }

@await Component.InvokeAsync("PageHeader", new { title = "人员权限", subtitle = "将登录账号映射为内部人员，并按部门授予角色", parentTitle = "权限管理", parentUrl = Url.Action("Index"), primaryText = "新增人员", primaryModalTarget = "#createStaff", secondaryText = "返回概览", secondaryUrl = Url.Action("Index") })
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-0 p-4">
    <form method="get" class="row g-2 align-items-center">
      <div class="col-12 col-md"><input class="form-control" name="keyword" value="@Model.Keyword" placeholder="搜索姓名或登录账号标识" /></div>
      <div class="col-auto"><button class="btn btn-dark" type="submit">搜索</button></div>
      <div class="col-auto"><a class="btn btn-outline-secondary" asp-action="Staff">重置</a></div>
    </form>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th class="ps-4">人员</th><th>部门</th><th>当前角色</th><th>状态</th><th class="text-end pe-4">授权</th></tr></thead>
      <tbody>
      @foreach (var item in Model.Staff) {
        var modalId = $"assign-{item.Id}";
        var passwordModalId = $"password-{item.Id}";
        <tr><td class="ps-4"><strong>@item.StaffName</strong><div class="small text-secondary">@item.StaffRef</div></td>
          <td>@item.Departments</td><td>@item.Roles</td>
          <td><span class="badge @(item.IsEnabled ? "text-bg-success" : "text-bg-secondary")">@(item.IsEnabled ? "启用" : "停用")</span></td>
          <td class="text-end pe-4"><div class="d-inline-flex gap-1"><button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#@modalId">授予角色</button><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#@passwordModalId">重置密码</button><form asp-action="SetStaffStatus" method="post"><input type="hidden" name="StaffId" value="@item.Id" /><input type="hidden" name="StaffRef" value="@item.StaffRef" /><input type="hidden" name="Enabled" value="@(!item.IsEnabled)" /><button class="btn btn-sm @(item.IsEnabled ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(item.IsEnabled ? "停用" : "启用")</button></form></div></td></tr>
        <div class="modal fade" id="@modalId" tabindex="-1">
          <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <form asp-action="AssignRole" method="post">
              <div class="modal-header"><h2 class="modal-title fs-5">为 @item.StaffName 授予角色</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
              <div class="modal-body">
                <input type="hidden" name="StaffId" value="@item.Id" />
                @{ var currentAssignments = Model.Assignments.Where(x => x.StaffId == item.Id).ToArray(); }
                @if (currentAssignments.Length > 0) {
                  <div class="mb-3"><label class="form-label">当前授权</label><div class="d-flex flex-column gap-2">
                    @foreach (var assignment in currentAssignments) {
                      <div class="d-flex align-items-center justify-content-between border rounded px-3 py-2"><span>@assignment.RoleName <small class="text-secondary">@(assignment.DepartmentName ?? "全局")</small></span><button class="btn btn-sm btn-outline-danger" type="submit" formaction="@Url.Action("RevokeRole")" name="AssignmentId" value="@assignment.Id">撤销</button></div>
                    }
                  </div></div>
                }
                <label class="form-label">角色</label>
                <select class="form-select mb-3" name="RoleId" required>
                  <option value="">请选择角色</option>
                  @foreach (var role in Model.Roles) { <option value="@role.Id">@role.Name（@role.DefaultScope）</option> }
                </select>
                <label class="form-label">生效部门</label>
                <select class="form-select" name="DepartmentId">
                  <option value="">全局（仅超级管理员、老板）</option>
                  @foreach (var department in Model.Departments) { <option value="@department.Id">@department.Name</option> }
                </select>
                <div class="form-text">部门管理员、部门主管、部门员工必须选择部门。</div>
              </div>
              <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button><button class="btn btn-dark" type="submit">确认授权</button></div>
            </form>
          </div></div>
        </div>
        <div class="modal fade" id="@passwordModalId" tabindex="-1">
          <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <form asp-action="ResetStaffPassword" method="post">
              <div class="modal-header"><h2 class="modal-title fs-5">重置 @item.StaffName 的密码</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
              <div class="modal-body"><input type="hidden" name="StaffRef" value="@item.StaffRef" /><label class="form-label">新密码</label><input class="form-control" name="NewPassword" type="password" autocomplete="new-password" required /><div class="form-text">至少 12 位，包含大小写字母、数字和特殊字符。保存后旧会话会失效。</div></div>
              <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">确认重置</button></div>
            </form>
          </div></div>
        </div>
      }
      @if (Model.Staff.Count == 0) { <tr><td colspan="5" class="text-center text-secondary py-5">没有符合条件的人员</td></tr> }
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="createStaff" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form asp-action="CreateStaff" method="post">
      <div class="modal-header"><h2 class="modal-title fs-5">新增登录人员</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-6"><label class="form-label">用户名</label><input class="form-control" name="UserName" required autocomplete="off" /></div>
          <div class="col-6"><label class="form-label">姓名</label><input class="form-control" name="StaffName" required /></div>
          <div class="col-12"><label class="form-label">邮箱</label><input class="form-control" name="Email" type="email" required /></div>
          <div class="col-12"><label class="form-label">初始密码</label><input class="form-control" name="Password" type="password" required autocomplete="new-password" /><div class="form-text">至少 12 位，包含大小写字母、数字和特殊字符。</div></div>
          <div class="col-12"><label class="form-label">初始角色</label><select class="form-select" name="RoleId" required><option value="">请选择角色</option>@foreach (var role in Model.Roles) { <option value="@role.Id">@role.Name（@role.DefaultScope）</option> }</select></div>
          <div class="col-12"><label class="form-label">所属部门</label><select class="form-select" name="DepartmentId"><option value="">全局（仅超级管理员、老板）</option>@foreach (var department in Model.Departments) { <option value="@department.Id">@department.Name</option> }</select></div>
        </div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">创建账号</button></div>
    </form>
  </div></div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/pages/security.css" asp-append-version="true" /> }
