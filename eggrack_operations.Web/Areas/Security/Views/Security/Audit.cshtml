@model PermissionAuditViewModel
@{ ViewData["Title"] = "权限审计"; var actions=Model.Items.Select(x=>x.ActionCode).Distinct().Order().ToArray();var targets=Model.Items.Select(x=>x.TargetType).Distinct().Order().ToArray(); }
<div class="page-heading"><div><h1>权限审计</h1><p>查询人员、角色、部门和权限配置的变更记录</p></div><a class="btn btn-outline-secondary" asp-action="Index">返回概览</a></div>
<div class="card border-0 shadow-sm mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-12 col-md-3"><label class="form-label">操作人员标识</label><input class="form-control" name="operatorRef" value="@Model.OperatorRef"/></div><div class="col-6 col-md-2"><label class="form-label">动作</label><select class="form-select" name="actionCode"><option value="">全部</option>@foreach(var action in actions){<option value="@action" selected="@(action==Model.ActionCode)">@action</option>}</select></div><div class="col-6 col-md-2"><label class="form-label">对象</label><select class="form-select" name="targetType"><option value="">全部</option>@foreach(var target in targets){<option value="@target" selected="@(target==Model.TargetType)">@target</option>}</select></div><div class="col-6 col-md-2"><label class="form-label">开始日期</label><input class="form-control" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")"/></div><div class="col-6 col-md-2"><label class="form-label">结束日期</label><input class="form-control" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")"/></div><div class="col-12 col-md-auto"><button class="btn btn-primary">查询</button> <a class="btn btn-outline-secondary" asp-action="Audit">重置</a></div></form></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">时间</th><th>操作人</th><th>动作</th><th>对象</th><th>来源</th><th class="text-end pe-4">详情</th></tr></thead><tbody>@foreach(var item in Model.Items){var modalId=$"audit-{item.Id}";<tr><td class="ps-4 text-nowrap">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td><code>@item.OperatorRef</code></td><td>@item.ActionCode</td><td>@item.TargetType / @(item.TargetRef??"—")</td><td>@(item.IpAddress??"—")</td><td class="text-end pe-4"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#@modalId">查看</button></td></tr><div class="modal fade" id="@modalId" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">审计记录 #@item.Id</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><dl class="row"><dt class="col-3">操作人</dt><dd class="col-9"><code>@item.OperatorRef</code></dd><dt class="col-3">动作</dt><dd class="col-9">@item.ActionCode</dd><dt class="col-3">对象</dt><dd class="col-9">@item.TargetType / @(item.TargetRef??"—")</dd><dt class="col-3">请求标识</dt><dd class="col-9">@(item.RequestId??"—")</dd></dl><h3 class="h6">变更前</h3><pre class="bg-body-tertiary rounded p-3 text-wrap">@(item.BeforeData??"—")</pre><h3 class="h6">变更后</h3><pre class="bg-body-tertiary rounded p-3 text-wrap">@(item.AfterData??"—")</pre></div></div></div></div>}@if(Model.Items.Count==0){<tr><td colspan="6" class="text-center text-secondary py-5">没有符合条件的审计记录</td></tr>}</tbody></table></div><div class="card-footer bg-white text-secondary small">最多显示最近 500 条记录</div></div>
@section Styles{<link rel="stylesheet" href="~/css/pages/security.css" asp-append-version="true"/>}
