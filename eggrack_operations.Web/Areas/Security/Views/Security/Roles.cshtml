@model IReadOnlyList<RoleListItem>
@{ ViewData["Title"] = "角色权限"; }

<div class="page-heading">
  <div><h1>角色权限</h1><p>查看五级角色、默认数据范围和当前授权规模</p></div>
  <a class="btn btn-outline-secondary" asp-action="Index">返回概览</a>
</div>

<div class="row g-3">
@foreach (var role in Model) {
  <div class="col-12 col-md-6 col-xl-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
          <div><span class="badge text-bg-dark mb-2">层级 @role.Level</span><h2 class="h5 mb-1">@role.Name</h2><code>@role.Code</code></div>
          <span class="badge @(role.IsEnabled ? "text-bg-success" : "text-bg-secondary")">@(role.IsEnabled ? "启用" : "停用")</span>
        </div>
        <dl class="row mb-0">
          <dt class="col-6 text-secondary fw-normal">默认范围</dt><dd class="col-6 text-end fw-semibold">@role.DefaultScope</dd>
          <dt class="col-6 text-secondary fw-normal">已授权人员</dt><dd class="col-6 text-end fw-semibold">@role.StaffCount</dd>
          <dt class="col-6 text-secondary fw-normal">权限点</dt><dd class="col-6 text-end fw-semibold">@role.PermissionCount</dd>
        </dl>
      </div>
    </div>
  </div>
}
</div>

