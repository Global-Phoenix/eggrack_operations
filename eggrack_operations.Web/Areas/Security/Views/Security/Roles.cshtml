@model RoleIndexViewModel
@{ ViewData["Title"] = "角色权限"; }
@await Component.InvokeAsync("PageHeader", new { title = "角色权限", subtitle = "查看角色层级并配置可执行的权限点", parentTitle = "权限管理", parentUrl = Url.Action("Index"), secondaryText = "返回概览", secondaryUrl = Url.Action("Index") })
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<div class="row g-3">@foreach(var role in Model.Roles){var modalId=$"role-{role.Id}";var selected=Model.Grants.Where(x=>x.RoleId==role.Id).Select(x=>x.PermissionId).ToHashSet();<div class="col-12 col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><div class="d-flex justify-content-between align-items-start mb-4"><div><span class="badge text-bg-dark mb-2">层级 @role.Level</span><h2 class="h5 mb-1">@role.Name</h2><code>@role.Code</code></div><span class="badge @(role.IsEnabled?"text-bg-success":"text-bg-secondary")">@(role.IsEnabled?"启用":"停用")</span></div><dl class="row mb-3"><dt class="col-6 text-secondary fw-normal">默认范围</dt><dd class="col-6 text-end fw-semibold">@role.DefaultScope</dd><dt class="col-6 text-secondary fw-normal">已授权人员</dt><dd class="col-6 text-end fw-semibold">@role.StaffCount</dd><dt class="col-6 text-secondary fw-normal">权限点</dt><dd class="col-6 text-end fw-semibold">@role.PermissionCount</dd></dl>@if(role.Code=="super_admin"){<div class="alert alert-light border small mb-0">系统固定拥有全部权限</div>}else{<button class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#@modalId">配置权限</button>}</div></div></div>
@if(role.Code!="super_admin"){<div class="modal fade" id="@modalId" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form asp-action="SaveRolePermissions" method="post"><div class="modal-header"><h2 class="modal-title fs-5">配置 @role.Name 权限</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="RoleId" value="@role.Id"/>@foreach(var group in Model.Permissions.Where(x=>x.IsEnabled).GroupBy(x=>x.ResourceType)){<h3 class="h6 mt-2">@group.Key</h3><div class="row g-2 mb-3">@foreach(var permission in group){<div class="col-12 col-md-6"><label class="border rounded p-3 d-flex gap-2 align-items-start h-100"><input class="form-check-input mt-1" type="checkbox" name="PermissionIds" value="@permission.Id" checked="@selected.Contains(permission.Id)"/><span><strong class="d-block">@permission.Name</strong><code class="small">@permission.Code</code></span></label></div>}</div>}</div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary">保存权限</button></div></form></div></div></div>}}
</div>
@section Styles{<link rel="stylesheet" href="~/css/pages/security.css" asp-append-version="true"/>}
