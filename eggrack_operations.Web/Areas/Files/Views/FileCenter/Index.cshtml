@model FileCenterIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "文件中心";
    var purchaseData = Model.PurchaseFiles.Select(file => new
    {
        name = file.OriginalName,
        type = file.FileType,
        size = file.FileSizeText,
        customer = file.CategoryName,
        sourceNumber = file.SourceNumber,
        sourceLabel = file.SourceLabel,
        uploadedBy = file.UploadedBy,
        uploadedDate = file.UploadedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"),
        sourceKind = file.SourceKind,
        fileId = file.FileId,
        previewKind = file.PreviewKind,
        visibility = file.VisibilityLabel,
        businessUrl = file.BusinessUrl
    });
}

@await Component.InvokeAsync("PageHeader", new {
    title = "文件中心",
    subtitle = "统一查询采购申请和采购计划附件；上传、分类及可见性在对应采购计划中管理",
    parentTitle = "业务管理",
    parentUrl = "/",
    statusText = "采购业务文件",
    statusTone = "primary"
})


<section class="file-center" data-file-center>
    <aside class="fc-sidebar">
        <div class="fc-sidebar-header">
            <span><i class="bi bi-diagram-3"></i>客户</span>
            <small class="text-secondary">分类</small>
        </div>
        <div class="fc-category-list" data-categories></div>
    </aside>

    <div class="fc-content">
        <div class="fc-content-head">
            <span><i class="bi bi-folder2-open"></i>采购业务文件</span>
            <small>共 @Model.PurchaseFiles.Count 个有效文件</small>
        </div>

        <form class="ui-toolbar" method="get" action="/files" data-server-query>
            <label class="ui-search">
                <i class="bi bi-search"></i>
                <input class="form-control" type="search" name="keyword" value="@Model.Query.Keyword" data-search placeholder="搜索文件名、业务编号或客户" />
            </label>
            <select class="form-select ui-filter" name="sourceKind" aria-label="业务来源">
                <option value="">全部来源</option>
                <option value="request" selected="@(Model.Query.SourceKind == "request")">采购申请</option>
                <option value="plan" selected="@(Model.Query.SourceKind == "plan")">采购计划</option>
            </select>
            <select class="form-select ui-filter" name="fileType" data-type aria-label="文件类型">
                <option value="">全部类型</option>
                @foreach (var type in new[] { "PDF", "JPG", "JPEG", "PNG", "WEBP", "MP4", "TXT", "CSV", "XLS", "XLSX", "DOCX", "ZIP" })
                {
                    <option value="@type" selected="@(Model.Query.FileType?.Equals(type, StringComparison.OrdinalIgnoreCase) == true)">@type</option>
                }
            </select>
            <select class="form-select ui-filter" name="dateRange" data-range aria-label="文件日期">
                <option value="">全部日期</option>
                <option value="week" selected="@(Model.Query.DateRange == "week")">近 7 天</option>
                <option value="month" selected="@(Model.Query.DateRange == "month")">近 30 天</option>
            </select>
            <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> 查询</button>
            <a class="btn btn-outline-secondary" href="/files">重置</a>
        </form>

        <div class="ui-data-table">
            <table class="table table-hover align-middle">
                <thead><tr><th>文件</th><th>业务来源</th><th>上传信息</th><th class="text-end"></th></tr></thead>
                <tbody data-rows></tbody>
            </table>
            <div class="fc-empty" data-empty>
                @await Component.InvokeAsync("EmptyState", new { title = "没有找到相关文件", description = "请调整关键词或筛选条件后重试", icon = "bi-search" })
            </div>
        </div>

        <div class="ui-pagination">
            <span data-result-count></span>
            <span>每页 20 条</span>
        </div>
    </div>

    @await Html.PartialAsync("_FilePreviewWorkspace")
</section>

@section Styles {
<link rel="stylesheet" href="~/css/components/file-preview.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/pages/file-center.css" asp-append-version="true" />
}

@section Scripts {
<script id="fileCenterData" type="application/json">@Html.Raw(JsonSerializer.Serialize(purchaseData))</script>
<script src="~/js/components/file-preview.js" asp-append-version="true"></script>
<script src="~/js/pages/file-center.js" asp-append-version="true"></script>
}
