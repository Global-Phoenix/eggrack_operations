@model FileCenterIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "文件中心";
    var purchaseData = Model.PurchaseFiles.Select(file => new object[]
    {
        file.OriginalName,
        file.FileType,
        file.FileSizeText,
        file.DepartmentName,
        file.SourceNumber,
        file.UploadedBy,
        file.UploadedAtUtc.ToString("yyyy-MM-dd"),
        file.StatusLabel
    });
}

@await Component.InvokeAsync("PageHeader", new {
    title = "文件中心",
    subtitle = "按采购部门或会员快速查找相关文件",
    parentTitle = "业务管理",
    parentUrl = "/",
    statusText = "只读",
    statusTone = "secondary"
})

<style>
.file-center{--fc-accent:#e99523;--fc-border:#e5e8ed;display:grid;grid-template-columns:220px minmax(0,1fr);gap:14px}
.fc-sidebar{align-self:start;overflow:hidden;border:1px solid var(--fc-border);border-radius:7px;background:#fff}
.fc-sidebar-header{height:50px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #edf0f4;font-size:13px;font-weight:650}
.fc-sidebar-header i{margin-right:7px;color:#8d96a3}
.fc-category-list{padding:7px}
.fc-category{width:100%;height:39px;padding:0 10px;display:flex;align-items:center;justify-content:space-between;border:0;border-radius:5px;background:transparent;color:#566171;text-align:left;font-size:12px}
.fc-category:hover{background:#f6f7f9;color:#303b4b}
.fc-category.active{background:#fff3df;color:#a55f0a;font-weight:650}
.fc-category-name{display:flex;align-items:center;gap:9px}
.fc-category-name i{font-size:14px}
.fc-category small{min-width:22px;padding:1px 6px;border-radius:9px;background:#f0f2f5;color:#7f8996;text-align:center}
.fc-category.active small{background:#fff;color:#a55f0a}
.fc-content{min-width:0}
.fc-tabs{height:47px;padding:0 12px;display:flex;align-items:end;gap:4px;border:1px solid var(--fc-border);border-bottom:0;border-radius:7px 7px 0 0;background:#fff}
.fc-tab{height:46px;padding:0 13px;border:0;border-bottom:2px solid transparent;background:transparent;color:#747f8e;font-size:12px;font-weight:600}
.fc-tab i{margin-right:6px}
.fc-tab.active{border-color:var(--fc-accent);color:#a9620b}
.fc-content .ui-toolbar{border-radius:0}
.fc-policy{margin-left:auto;white-space:nowrap}
.fc-file{display:flex;align-items:center;gap:10px;min-width:250px}
.fc-file-icon{width:34px;height:38px;display:grid;place-items:center;border-radius:6px;background:#edf1f6;color:#647083;font-size:16px}
.fc-file-icon.pdf{background:#feeeee;color:#ad4d4d}
.fc-file-icon.xlsx{background:#e9f6ed;color:#2f8051}
.fc-file-icon.docx{background:#eaf1fb;color:#4673b5}
.fc-file-icon.zip{background:#f3eefb;color:#7459a5}
.fc-file strong{display:block;font-size:12px;font-weight:650}
.fc-file small,.file-center td small{display:block;margin-top:2px;color:#8a94a1;font-size:10px}
.fc-state{padding:3px 7px;border-radius:10px;background:#eef2f6;color:#637083;font-size:10px}
.fc-state.review{background:#fff1d8;color:#93600e}
.fc-state.warning{background:#ffeded;color:#a84b4b}
.fc-empty{display:none}
.fc-preview{height:150px;margin:18px 0;display:grid;place-items:center;border:1px dashed #d1d6dd;border-radius:7px;background:#f8f9fb;color:#9aa2ad}
.fc-preview i{display:block;margin-bottom:6px;font-size:30px;color:#b7bec7}
.fc-meta{display:grid;grid-template-columns:96px 1fr;padding:11px 0;border-bottom:1px solid #edf0f3;font-size:12px}
.fc-meta span{color:#7b8593}
.file-center .offcanvas{--bs-offcanvas-width:420px}
@@media(max-width:991.98px){.file-center{grid-template-columns:1fr}.fc-sidebar{display:flex;overflow:auto}.fc-sidebar-header{display:none}.fc-category-list{display:flex;gap:4px}.fc-category{width:auto;min-width:max-content}.fc-policy{margin-left:0}}
@@media(max-width:575.98px){.fc-tabs{overflow:auto}.fc-tab{min-width:max-content}.file-center .ui-toolbar{padding:8px}.fc-policy{width:100%}}
</style>

<section class="file-center" data-file-center>
    <aside class="fc-sidebar">
        <div class="fc-sidebar-header">
            <span><i class="bi bi-diagram-3"></i><span data-tree-title>计划部门</span></span>
            <small class="text-secondary">分类</small>
        </div>
        <div class="fc-category-list" data-categories></div>
    </aside>

    <div class="fc-content">
        <div class="fc-tabs" role="tablist">
            <button class="fc-tab active" type="button" data-mode="purchase"><i class="bi bi-file-earmark-text"></i>采购申请文件</button>
            <button class="fc-tab" type="button" data-mode="member"><i class="bi bi-people"></i>会员文件</button>
        </div>

        <div class="ui-toolbar">
            <label class="ui-search">
                <i class="bi bi-search"></i>
                <input class="form-control" type="search" data-search placeholder="搜索文件名或申请编号" />
            </label>
            <select class="form-select ui-filter" data-type aria-label="文件类型">
                <option value="">全部类型</option><option>PDF</option><option>XLSX</option><option>DOCX</option><option>ZIP</option>
            </select>
            <select class="form-select ui-filter" data-range aria-label="文件日期">
                <option value="">全部日期</option><option value="week">近 7 天</option><option value="month">近 30 天</option>
            </select>
            <button class="btn btn-outline-secondary fc-policy" type="button" data-policy data-bs-toggle="offcanvas" data-bs-target="#fileDetail">
                <i class="bi bi-clock-history"></i> 清理策略
            </button>
        </div>

        <div class="ui-data-table">
            <table class="table table-hover align-middle">
                <thead><tr><th>文件</th><th data-group-head>来源单号</th><th>上传人</th><th>上传时间</th><th>状态</th><th class="text-end"></th></tr></thead>
                <tbody data-rows></tbody>
            </table>
            <div class="fc-empty" data-empty>
                @await Component.InvokeAsync("EmptyState", new { title = "没有找到相关文件", description = "请调整关键词或筛选条件后重试", icon = "bi-search" })
            </div>
        </div>

        <div class="ui-pagination">
            <span data-result-count></span>
            <span>每页 20 条</span>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="fileDetail" aria-labelledby="fileDetailTitle">
        <div class="offcanvas-header border-bottom">
            <div><small class="text-secondary" data-detail-label>文件详情</small><h5 class="offcanvas-title mt-1" id="fileDetailTitle" data-detail-name></h5></div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="关闭"></button>
        </div>
        <div class="offcanvas-body">
            <small class="text-secondary" data-detail-sub></small>
            <div class="fc-preview" data-preview><div><i class="bi bi-file-earmark"></i>暂无预览</div></div>
            <div data-detail-meta></div>
        </div>
        <div class="p-3 border-top d-flex gap-2">
            <button class="btn btn-outline-secondary flex-fill" type="button" data-secondary><i class="bi bi-link-45deg"></i> 复制链接</button>
            <button class="btn btn-primary flex-fill" type="button" data-primary><i class="bi bi-download"></i> 下载</button>
        </div>
    </div>
</section>

@section Scripts {
<script>
(() => {
  const root=document.querySelector('[data-file-center]'); if(!root)return;
  const data={
    purchase:@Html.Raw(JsonSerializer.Serialize(purchaseData)),
    member:[]
  };
  const groups={
    purchase:['全部部门',...new Set(data.purchase.map(file=>file[3]))],
    member:['全部会员']
  };
  const icons={PDF:'bi-file-earmark-pdf',XLSX:'bi-file-earmark-spreadsheet',DOCX:'bi-file-earmark-word',ZIP:'bi-file-earmark-zip'};
  let mode='purchase',group='全部部门'; const q=s=>root.querySelector(s);

  function categories(){
    const box=q('[data-categories]');box.innerHTML='';
    groups[mode].forEach((name,index)=>{
      const button=document.createElement('button');button.type='button';button.className='fc-category '+(name===group?'active':'');
      const icon=index===0?(mode==='purchase'?'bi-grid':'bi-people'):(mode==='purchase'?'bi-building':'bi-person');
      button.innerHTML='<span class="fc-category-name"><i class="bi '+icon+'"></i>'+name+'</span><small>'+(index?data[mode].filter(x=>x[3]===name).length:data[mode].length)+'</small>';
      button.onclick=()=>{group=name;categories();render()};box.appendChild(button);
    });
  }

  function render(){
    const keyword=q('[data-search]').value.toLowerCase(),type=q('[data-type]').value,range=q('[data-range]').value;
    const cutoff=range==='week'?'2026-09-22':range==='month'?'2026-08-29':'';
    const items=data[mode].filter(x=>(group.startsWith('全部')||x[3]===group)&&(!type||x[1]===type)&&(!cutoff||x[6]>=cutoff)&&(!keyword||(x[0]+x[3]+x[4]).toLowerCase().includes(keyword)));
    const body=q('[data-rows]');body.innerHTML='';
    items.forEach(x=>{
      const row=document.createElement('tr');const state=x[7].includes('清理')?'warning':x[7]==='审批中'?'review':'';
      row.innerHTML='<td><div class="fc-file"><span class="fc-file-icon '+x[1].toLowerCase()+'"><i class="bi '+icons[x[1]]+'"></i></span><span><strong>'+x[0]+'</strong><small>'+x[2]+'</small></span></div></td><td><strong class="small">'+x[4]+'</strong><small>'+x[3]+'</small></td><td>'+x[5]+'</td><td>'+x[6]+'</td><td><span class="fc-state '+state+'">'+x[7]+'</span></td><td class="text-end text-secondary"><i class="bi bi-chevron-right"></i></td>';
      row.onclick=()=>detail(x);body.appendChild(row);
    });
    q('[data-empty]').style.display=items.length?'none':'block';
    q('[data-result-count]').textContent='共 '+items.length+' 个文件';
  }

  function detail(x){
    q('[data-detail-label]').textContent='文件详情';q('[data-detail-name]').textContent=x[0];q('[data-detail-sub]').textContent=x[1]+' · '+x[2];
    q('[data-preview]').innerHTML='<div><i class="bi '+icons[x[1]]+'"></i>暂无预览</div>';
    q('[data-detail-meta]').innerHTML='<div class="fc-meta"><span>'+(mode==='purchase'?'采购申请':'会员编号')+'</span><strong>'+x[4]+'</strong></div><div class="fc-meta"><span>'+(mode==='purchase'?'计划部门':'所属会员')+'</span><strong>'+x[3]+'</strong></div><div class="fc-meta"><span>上传信息</span><strong>'+x[5]+' · '+x[6]+'</strong></div><div class="fc-meta"><span>文件状态</span><strong>'+x[7]+'</strong></div>';
    bootstrap.Offcanvas.getOrCreateInstance(q('#fileDetail')).show();
  }

  function setMode(next){
    mode=next;group=groups[next][0];
    root.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('active',x.dataset.mode===next));
    q('[data-tree-title]').textContent=next==='purchase'?'计划部门':'会员分类';
    q('[data-group-head]').textContent=next==='purchase'?'来源单号':'所属会员';
    q('[data-search]').placeholder=next==='purchase'?'搜索文件名或申请编号':'搜索文件名或会员编号';
    q('[data-policy]').style.display=next==='member'?'block':'none';categories();render();
  }

  root.querySelectorAll('[data-mode]').forEach(x=>x.onclick=()=>setMode(x.dataset.mode));
  q('[data-search]').oninput=render;q('[data-type]').onchange=render;q('[data-range]').onchange=render;
  q('[data-policy]').onclick=()=>{
    q('[data-detail-label]').textContent='自动清理';q('[data-detail-name]').textContent='会员文件清理策略';q('[data-detail-sub]').textContent='仅清理已失效且不再被业务引用的文件';
    q('[data-preview]').innerHTML='<div><i class="bi bi-clock-history"></i><strong class="d-block fs-4 text-primary">90 天</strong>业务结束后的保留期</div>';
    q('[data-detail-meta]').innerHTML='<div class="fc-meta"><span>执行频率</span><strong>每日 02:00</strong></div><div class="fc-meta"><span>提前提醒</span><strong>清理前 7 天</strong></div><div class="fc-meta"><span>最近执行</span><strong>2026-09-28 · 已完成</strong></div>';
  };
  setMode('purchase');
})();
</script>
}
