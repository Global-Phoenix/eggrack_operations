@{
    ViewData["Title"] = "文件中心";
}
<style>
.file-center{--fc-orange:#e99523;--fc-line:#e5e8ed;--fc-muted:#7d8795}.file-center .fc-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}.file-center .fc-heading h1{font-size:25px;font-weight:700;margin:0 0 5px}.file-center .fc-heading p{margin:0;color:var(--fc-muted)}.file-center .fc-summary{display:flex;gap:10px}.file-center .fc-stat{min-width:112px;padding:10px 14px;background:#fff;border:1px solid var(--fc-line);border-radius:8px}.file-center .fc-stat strong{display:block;font-size:20px;line-height:1.25}.file-center .fc-stat span{font-size:11px;color:var(--fc-muted)}.file-center .fc-tabs{display:flex;gap:2px;border-bottom:1px solid var(--fc-line);margin-bottom:14px}.file-center .fc-tab{border:0;background:transparent;color:#6f7988;padding:11px 16px;border-bottom:3px solid transparent;font-weight:600}.file-center .fc-tab.active{color:#b86d10;border-color:var(--fc-orange)}.file-center .fc-workspace{display:grid;grid-template-columns:230px minmax(0,1fr);gap:14px}.file-center .fc-card{background:#fff;border:1px solid var(--fc-line);border-radius:8px;box-shadow:0 3px 12px #202a3b08}.file-center .fc-tree{padding:14px;height:max-content}.file-center .fc-tree-head{display:flex;align-items:center;justify-content:space-between;padding:2px 8px 11px;font-size:13px;font-weight:700}.file-center .fc-count{font-size:11px;color:#8b94a2;background:#f2f4f7;border-radius:99px;padding:2px 7px}.file-center .fc-category{width:100%;display:flex;align-items:center;justify-content:space-between;border:0;background:transparent;color:#505b6b;padding:9px 10px;border-radius:6px;text-align:left}.file-center .fc-category:hover,.file-center .fc-category.active{background:#fff4e5;color:#a9630d;font-weight:600}.file-center .fc-folder{color:#d98a21;margin-right:7px}.file-center .fc-toolbar{padding:13px;border-bottom:1px solid var(--fc-line);display:flex;align-items:center;gap:8px;flex-wrap:wrap}.file-center .fc-search{position:relative;flex:1;min-width:220px}.file-center .fc-search input{padding-left:35px}.file-center .fc-search span{position:absolute;left:12px;top:8px;color:#929aa6}.file-center .form-control,.file-center .form-select{border-color:#dfe3e8;font-size:13px;min-height:38px}.file-center .form-control:focus,.file-center .form-select:focus{border-color:#e5a44d;box-shadow:0 0 0 .2rem #e9952318}.file-center .fc-policy{border:0;background:#fff3df;color:#a9620c;padding:8px 11px;border-radius:6px;font-weight:600;font-size:12px}.file-center .fc-table-wrap{overflow:auto}.file-center .table{margin:0;min-width:760px}.file-center .table th{background:#fafbfc;color:#758091;font-size:11px;font-weight:600;padding:10px 14px;border-color:#edf0f3}.file-center .table td{padding:13px 14px;border-color:#edf0f3;vertical-align:middle}.file-center .table tbody tr{cursor:pointer}.file-center .table tbody tr:hover{background:#fffdf9}.file-center .fc-file{display:flex;align-items:center;gap:10px;min-width:240px}.file-center .fc-type{width:36px;height:40px;display:grid;place-items:center;border-radius:7px;background:#edf1f6;color:#566274;font-size:10px;font-weight:800}.file-center .fc-type.pdf{background:#ffeded;color:#ae4d4d}.file-center .fc-type.xlsx{background:#e9f6ed;color:#2e8150}.file-center .fc-file strong{display:block;font-size:13px}.file-center .fc-file small,.file-center td small{display:block;color:#8c95a2;font-size:11px}.file-center .fc-status{display:inline-block;padding:4px 8px;border-radius:99px;background:#eef2f6;color:#637083;font-size:11px}.file-center .fc-status.warning{background:#fff1d7;color:#94600e}.file-center .fc-footer{display:flex;justify-content:space-between;padding:12px 14px;border-top:1px solid var(--fc-line);font-size:11px;color:#8b94a2}.file-center .fc-empty{display:none;text-align:center;padding:58px 20px;color:#8993a1}.file-center .fc-empty strong{display:block;color:#404b5b;font-size:15px;margin-bottom:4px}.file-center .offcanvas{--bs-offcanvas-width:430px}.file-center .fc-preview{height:170px;background:#f5f7f9;border:1px dashed #cdd3da;border-radius:8px;display:grid;place-items:center;color:#8d96a2;margin:18px 0}.file-center .fc-meta{display:grid;grid-template-columns:105px 1fr;padding:11px 0;border-bottom:1px solid #edf0f3}.file-center .fc-meta span{color:#7d8795}@@media(max-width:991.98px){.file-center .fc-workspace{grid-template-columns:1fr}.file-center .fc-tree{display:flex;gap:5px;overflow:auto;padding:9px}.file-center .fc-tree-head{display:none}.file-center .fc-category{width:auto;white-space:nowrap}.file-center .fc-summary{display:none}}@@media(max-width:575.98px){.file-center .fc-heading{align-items:flex-start}.file-center .fc-tab{padding:10px 11px}.file-center .fc-toolbar{padding:10px}.file-center .fc-footer{display:none}}
</style>

<section class="file-center" data-file-center>
    <div class="fc-heading">
        <div><h1>文件中心</h1><p>统一查看采购申请与会员相关文件</p></div>
        <div class="d-flex align-items-center gap-2">
            <div class="fc-summary">
                <div class="fc-stat"><strong data-total>28</strong><span>当前文件</span></div>
                <div class="fc-stat"><strong>1.86 GB</strong><span>占用空间</span></div>
            </div>
        </div>
    </div>

    <div class="fc-tabs" role="tablist">
        <button class="fc-tab active" type="button" data-mode="purchase">采购申请文件</button>
        <button class="fc-tab" type="button" data-mode="member">会员文件</button>
    </div>

    <div class="fc-workspace">
        <aside class="fc-card fc-tree">
            <div class="fc-tree-head"><span data-tree-title>计划部门</span><span class="fc-count">4 个分类</span></div>
            <div data-categories></div>
        </aside>

        <div class="fc-card overflow-hidden">
            <div class="fc-toolbar">
                <label class="fc-search"><span>⌕</span><input class="form-control" data-search placeholder="搜索文件名或申请编号" /></label>
                <select class="form-select w-auto" data-type aria-label="文件类型"><option value="">全部类型</option><option>PDF</option><option>XLSX</option><option>DOCX</option><option>ZIP</option></select>
                <select class="form-select w-auto" data-range aria-label="上传日期"><option value="">全部日期</option><option value="week">近 7 天</option><option value="month">近 30 天</option></select>
                <button class="fc-policy" type="button" data-policy data-bs-toggle="offcanvas" data-bs-target="#fileDetail">清理策略 · 已开启</button>
            </div>
            <div class="fc-table-wrap">
                <table class="table table-hover align-middle">
                    <thead><tr><th>文件</th><th data-group-head>采购申请</th><th>上传人</th><th>上传时间</th><th>状态</th></tr></thead>
                    <tbody data-rows></tbody>
                </table>
                <div class="fc-empty" data-empty><strong>没有找到相关文件</strong><span>请更换关键词或筛选条件</span></div>
            </div>
            <div class="fc-footer"><span data-result-count></span><span>每页 20 条　1 / 1</span></div>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="fileDetail" aria-labelledby="fileDetailTitle">
        <div class="offcanvas-header border-bottom"><div><small class="text-secondary" data-detail-label>文件详情</small><h5 class="offcanvas-title mt-1" id="fileDetailTitle" data-detail-name></h5></div><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
        <div class="offcanvas-body"><small class="text-secondary" data-detail-sub></small><div class="fc-preview" data-preview>文档预览区域</div><div data-detail-meta></div></div>
        <div class="p-3 border-top d-flex gap-2"><button class="btn btn-outline-secondary flex-fill" type="button" data-secondary>复制链接</button><button class="btn btn-warning flex-fill" type="button" data-primary>下载文件</button></div>
    </div>

    </div>
</section>

@section Scripts {
<script>
(() => {
  const root=document.querySelector('[data-file-center]'); if(!root)return;
  const data={
    purchase:[
      ['设备采购技术规格说明.pdf','PDF','2.4 MB','信息技术部','PR-2026-0928-018','陈嘉','2026-09-28','审批中'],
      ['供应商比价表.xlsx','XLSX','846 KB','行政部','PR-2026-0927-012','刘静','2026-09-27','已归档'],
      ['办公家具采购清单.xlsx','XLSX','1.1 MB','行政部','PR-2026-0925-006','王悦','2026-09-25','已归档'],
      ['冷链运输服务合同.docx','DOCX','728 KB','供应链部','PR-2026-0924-021','周航','2026-09-24','审批中'],
      ['门店物料设计源文件.zip','ZIP','184 MB','市场部','PR-2026-0922-009','许岚','2026-09-22','已归档']],
    member:[
      ['营业执照副本.pdf','PDF','3.2 MB','华东鲜选','MB-10028','赵然','2026-09-26','长期保留'],
      ['门店信息登记表.xlsx','XLSX','422 KB','华东鲜选','MB-10028','赵然','2026-09-26','长期保留'],
      ['会员合作协议.pdf','PDF','4.8 MB','北方优品','MB-10016','沈宜','2026-09-18','还剩 81 天'],
      ['食品经营许可证.pdf','PDF','2.1 MB','湾区食集','MB-10031','林晓宇','2026-09-12','还剩 75 天'],
      ['历史对账附件.zip','ZIP','76 MB','北方优品','MB-10016','系统迁移','2026-06-10','7 天后清理']]};
  const groups={purchase:['全部部门','行政部','信息技术部','供应链部','市场部'],member:['全部会员','华东鲜选','北方优品','湾区食集']};
  let mode='purchase',group='全部部门'; const q=s=>root.querySelector(s);
  function categories(){const box=q('[data-categories]');box.innerHTML='';groups[mode].forEach((name,i)=>{const b=document.createElement('button');b.type='button';b.className='fc-category '+(name===group?'active':'');b.innerHTML='<span><span class="fc-folder">▰</span>'+name+'</span><small>'+(i?data[mode].filter(x=>x[3]===name).length:data[mode].length)+'</small>';b.onclick=()=>{group=name;categories();render()};box.appendChild(b)})}
  function render(){const keyword=q('[data-search]').value.toLowerCase(),type=q('[data-type]').value,range=q('[data-range]').value,cutoff=range==='week'?'2026-09-22':range==='month'?'2026-08-29':'';const items=data[mode].filter(x=>(group.startsWith('全部')||x[3]===group)&&(!type||x[1]===type)&&(!cutoff||x[6]>=cutoff)&&(!keyword||(x[0]+x[3]+x[4]).toLowerCase().includes(keyword)));const body=q('[data-rows]');body.innerHTML='';items.forEach(x=>{const tr=document.createElement('tr');tr.innerHTML='<td><div class="fc-file"><span class="fc-type '+x[1].toLowerCase()+'">'+x[1]+'</span><span><strong>'+x[0]+'</strong><small>'+x[2]+'</small></span></div></td><td><strong class="small">'+x[4]+'</strong><small>'+x[3]+'</small></td><td>'+x[5]+'</td><td>'+x[6]+'</td><td><span class="fc-status '+(x[7].includes('清理')?'warning':'')+'">'+x[7]+'</span></td>';tr.onclick=()=>detail(x);body.appendChild(tr)});q('[data-empty]').style.display=items.length?'none':'block';q('[data-result-count]').textContent='共 '+items.length+' 个文件';q('[data-total]').textContent=mode==='purchase'?'28':'16'}
  function detail(x){q('[data-detail-label]').textContent='文件详情';q('[data-detail-name]').textContent=x[0];q('[data-detail-sub]').textContent=x[1]+' · '+x[2];q('[data-preview]').innerHTML='文档预览区域';q('[data-detail-meta]').innerHTML='<div class="fc-meta"><span>'+(mode==='purchase'?'采购申请':'会员编号')+'</span><strong>'+x[4]+'</strong></div><div class="fc-meta"><span>'+(mode==='purchase'?'计划部门':'所属会员')+'</span><strong>'+x[3]+'</strong></div><div class="fc-meta"><span>上传信息</span><strong>'+x[5]+' · '+x[6]+'</strong></div><div class="fc-meta"><span>文件状态</span><strong>'+x[7]+'</strong></div>';bootstrap.Offcanvas.getOrCreateInstance(q('#fileDetail')).show()}
  function setMode(next){mode=next;group=groups[next][0];root.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('active',x.dataset.mode===next));q('[data-tree-title]').textContent=next==='purchase'?'计划部门':'会员分类';q('[data-group-head]').textContent=next==='purchase'?'采购申请':'所属会员';q('[data-search]').placeholder=next==='purchase'?'搜索文件名或申请编号':'搜索文件名或会员编号';q('[data-policy]').style.display=next==='member'?'block':'none';categories();render()}
  root.querySelectorAll('[data-mode]').forEach(x=>x.onclick=()=>setMode(x.dataset.mode));q('[data-search]').oninput=render;q('[data-type]').onchange=render;q('[data-range]').onchange=render;q('[data-policy]').onclick=()=>{q('[data-detail-label]').textContent='自动清理';q('[data-detail-name]').textContent='会员文件清理策略';q('[data-detail-sub]').textContent='仅清理已失效且不再被业务引用的文件';q('[data-preview]').innerHTML='<div class="text-center"><strong class="fs-3 text-warning">90 天</strong><br><span>业务结束后的保留期</span></div>';q('[data-detail-meta]').innerHTML='<div class="fc-meta"><span>执行频率</span><strong>每日 02:00</strong></div><div class="fc-meta"><span>提前提醒</span><strong>清理前 7 天</strong></div><div class="fc-meta"><span>最近执行</span><strong>2026-09-28 · 已完成</strong></div>'};setMode('purchase');
})();
</script>
}
