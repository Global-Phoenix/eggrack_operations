@model FileCenterIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "文件中心";
    var purchaseData = Model.PurchaseFiles.Select(file => new object[]
    {
        file.OriginalName,
        file.FileType,
        file.FileSizeText,
        file.CategoryName,
        file.SourceNumber,
        file.UploadedBy,
        file.UploadedAtUtc.ToString("yyyy-MM-dd"),
        file.StatusLabel,
        file.SourceKind,
        file.FileId,
        file.PreviewKind
    });
}

@await Component.InvokeAsync("PageHeader", new {
    title = "文件中心",
    subtitle = "按实际会员与部门目录查找客户文件和内部文件",
    parentTitle = "业务管理",
    parentUrl = "/",
    statusText = "只读",
    statusTone = "secondary"
})


<section class="file-center" data-file-center>
    <aside class="fc-sidebar">
        <div class="fc-sidebar-header">
            <span><i class="bi bi-diagram-3"></i><span data-tree-title>客户</span></span>
            <small class="text-secondary">分类</small>
        </div>
        <div class="fc-category-list" data-categories></div>
    </aside>

    <div class="fc-content">
        <div class="fc-tabs" role="tablist">
            <button class="fc-tab active" type="button" data-mode="customer"><i class="bi bi-person-vcard"></i>客户文件</button>
            <button class="fc-tab" type="button" data-mode="internal"><i class="bi bi-shield-lock"></i>内部文件</button>
        </div>

        <div class="ui-toolbar">
            <label class="ui-search">
                <i class="bi bi-search"></i>
                <input class="form-control" type="search" data-search placeholder="搜索文件名或申请编号" />
            </label>
            <select class="form-select ui-filter" data-type aria-label="文件类型">
                <option value="">全部类型</option><option>PDF</option><option>JPG</option><option>JPEG</option><option>PNG</option><option>WEBP</option><option>MP4</option><option>TXT</option><option>CSV</option><option>XLS</option><option>XLSX</option><option>DOCX</option><option>ZIP</option>
            </select>
            <select class="form-select ui-filter" data-range aria-label="文件日期">
                <option value="">全部日期</option><option value="week">近 7 天</option><option value="month">近 30 天</option>
            </select>
            <button class="btn btn-outline-secondary fc-policy" type="button" data-policy>
                <i class="bi bi-clock-history"></i> 清理策略
            </button>
        </div>

        <div class="ui-data-table">
            <table class="table table-hover align-middle">
                <thead><tr><th>文件</th><th data-group-head>来源单号</th><th>上传信息</th><th class="text-end"></th></tr></thead>
                <tbody data-rows></tbody>
            </table>
            <div class="fc-empty" data-empty>
                @await Component.InvokeAsync("EmptyState", new { title = "没有找到相关文件", description = "请调整关键词或筛选条件后重试", icon = "bi-search" })
            </div>
        </div>

        <div class="ui-pagination">
            <span data-result-count></span>
            <span>每页 20 条</span>
        </div>
    </div>

    <aside class="fc-detail" data-detail-panel aria-labelledby="fileDetailTitle">
        <div class="fc-detail-header">
            <div><small class="text-secondary" data-detail-label>文件预览</small><h5 class="mt-1 mb-0" id="fileDetailTitle" data-detail-name>选择文件查看</h5></div>
        </div>
        <div class="fc-detail-body">
            <small class="text-secondary" data-detail-sub>从左侧列表中选择一个文件</small>
            <div class="fc-preview" data-preview><div><i class="bi bi-file-earmark"></i>暂无预览</div></div>
            <div data-detail-meta></div>
        </div>
        <div class="fc-detail-actions">
            <button class="btn btn-outline-secondary flex-fill" type="button" data-secondary disabled><i class="bi bi-link-45deg"></i> 复制链接</button>
            <button class="btn btn-primary flex-fill" type="button" data-primary disabled><i class="bi bi-download"></i> 下载</button>
        </div>
    </aside>
</section>

@section Styles { <link rel="stylesheet" href="~/css/pages/file-center.css" asp-append-version="true" /> }

@section Scripts {
<script id="fileCenterData" type="application/json">@Html.Raw(JsonSerializer.Serialize(purchaseData))</script>
<script src="~/js/pages/file-center.js" asp-append-version="true"></script>
}
