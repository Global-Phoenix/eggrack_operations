@model PurchasePlanSourcingTabViewModel
@{
 var plan=Model.Plan;
 var data=Model.Data;
 var relatedSupplierIds=data.Inquiries.Select(x=>x.SupplierId).Concat(data.Samples.Where(x=>x.SupplierId.HasValue).Select(x=>x.SupplierId!.Value)).Distinct().ToHashSet();
 var relatedSuppliers=data.Suppliers.Where(x=>relatedSupplierIds.Contains(x.Id)).ToArray();
 string Display(string? value)=>string.IsNullOrWhiteSpace(value)?"—":value;
}
<div class="er-section-header"><div><h2>供应商与询价</h2><p>供应商档案是公司级数据；报价和样品只关联当前采购计划。每个计划产品应选择一条有效报价。</p></div>
 @if(Model.CanExecuteProcurement&&plan.Status is 1 or 2 or 7){<div class="d-flex gap-2 flex-wrap"><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#supplierModal">新增供应商</button><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#inquiryModal">录入供应商报价</button><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#sampleModal">添加样品</button></div>}
</div>
<section class="ui-panel p-4 mb-3">
 <div class="er-section-header"><div><h2>本计划相关供应商</h2><p>根据当前报价和样品记录自动汇总。</p></div><span class="ui-version">@relatedSuppliers.Length 家</span></div>
 @if(relatedSuppliers.Length==0){<div class="compact-empty"><i class="bi bi-building"></i><span>尚未关联供应商，请先录入供应商报价。</span></div>}
 else{<div class="row g-3">@foreach(var supplier in relatedSuppliers){<div class="col-lg-4"><article class="plan-file-card h-100"><span class="plan-file-icon"><i class="bi bi-building"></i></span><div><strong>@supplier.Name</strong><small>@Display(supplier.ContactName) · @Display(supplier.ContactPhone)</small><small>@Display(supplier.Address)</small></div></article></div>}</div>}
</section>
<section class="ui-panel p-4 mb-3">
 <div class="er-section-header"><div><h2>供应商报价</h2><p>保留报价修订版本，选中的最新报价作为产品成本依据。</p></div></div>
 <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>计划产品</th><th>供应商 / 提供产品</th><th>产品参数</th><th>报价</th><th>MOQ / 交期</th><th>有效期</th><th>状态</th><th></th></tr></thead><tbody>
 @foreach(var inquiry in data.Inquiries){
  <tr><td><strong>@inquiry.ProductName</strong></td><td>@inquiry.SupplierName<small class="ui-cell-secondary">@Display(inquiry.OfferedProductName) · V@(inquiry.RevisionNo)</small></td><td><small>@(inquiry.LengthCm.HasValue?$"{inquiry.LengthCm:0.##}×{inquiry.WidthCm:0.##}×{inquiry.HeightCm:0.##} cm":"—")</small><small class="ui-cell-secondary">@Display(inquiry.Color) · @Display(inquiry.SizeDetails) · @Display(inquiry.ParameterDetails)</small></td><td><strong>@inquiry.Currency @(inquiry.UnitPrice?.ToString("N4")??"—")</strong></td><td>@(inquiry.Moq?.ToString("0.###")??"—") / @(inquiry.LeadDays.HasValue?$"{inquiry.LeadDays} 天":"—")</td><td>@(inquiry.ValidUntil?.ToString("yyyy-MM-dd")??"—")</td><td><span class="ui-status ui-status-@(inquiry.IsSelected?"success":inquiry.Status=="quoted"?"warning":"neutral")"><i></i>@(inquiry.IsSelected?"已选用":inquiry.Status=="quoted"?"已报价":inquiry.Status=="sent"?"已询价":"草稿")</span></td><td class="text-end">@if(Model.CanExecuteProcurement&&plan.Status==2&&inquiry.Status=="quoted"&&inquiry.UnitPrice>0&&!inquiry.IsSelected){<form asp-action="SelectPlanInquiry" asp-route-planId="@plan.Id" method="post"><input type="hidden" name="PlanItemId" value="@inquiry.PlanItemId"><input type="hidden" name="InquiryId" value="@inquiry.Id"><button class="btn btn-sm btn-outline-primary" type="submit">选用</button></form>}</td></tr>
 }
 @if(data.Inquiries.Count==0){<tr><td colspan="8"><div class="compact-empty"><i class="bi bi-receipt-cutoff"></i><span>尚未录入供应商报价。</span></div></td></tr>}
 </tbody></table></div>
</section>
<section class="ui-panel p-4">
 <div class="er-section-header"><div><h2>样品记录</h2><p>样品为可选环节，可在文件页上传并关联样品附件。</p></div><span class="ui-version">@data.Samples.Count 条</span></div>
 <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>产品</th><th>供应商</th><th>数量</th><th>状态</th><th>成本 CNY</th><th>物流单号</th><th>说明</th></tr></thead><tbody>
 @foreach(var sample in data.Samples){<tr><td>@sample.ProductName</td><td>@Display(sample.SupplierName)</td><td>@sample.Quantity.ToString("0.###")</td><td>@sample.Status</td><td>@sample.CostCny.ToString("N2")</td><td>@Display(sample.TrackingNumber)</td><td>@Display(sample.Notes)</td></tr>}
 @if(data.Samples.Count==0){<tr><td colspan="7"><div class="compact-empty"><i class="bi bi-box-seam"></i><span>当前计划没有样品记录。</span></div></td></tr>}
 </tbody></table></div>
</section>
@if(Model.CanExecuteProcurement&&plan.Status is 1 or 2 or 7){
 <div class="modal fade" id="supplierModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form asp-action="CreatePlanSupplier" asp-route-planId="@plan.Id" method="post"><div class="modal-header"><div><h2 class="modal-title fs-5">新增供应商档案</h2><p class="mb-0 text-muted">供应商保存后可被其他采购计划复用。</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">供应商名称</label><input class="form-control" name="Name" required></div><div class="col-md-6"><label class="form-label">供应商编码（可选）</label><input class="form-control" name="Code"></div><div class="col-12"><label class="form-label">地址</label><input class="form-control" name="Address"></div><div class="col-md-6"><label class="form-label">法人</label><input class="form-control" name="LegalRepresentative"></div><div class="col-md-6"><label class="form-label">联系人</label><input class="form-control" name="ContactName"></div><div class="col-md-6"><label class="form-label">联系电话</label><input class="form-control" name="ContactPhone"></div><div class="col-md-6"><label class="form-label">网址</label><input class="form-control" name="Website" type="url" placeholder="https://"></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存供应商</button></div></form></div></div></div>
 <div class="modal fade" id="inquiryModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form asp-action="SavePlanInquiry" asp-route-planId="@plan.Id" method="post"><div class="modal-header"><div><h2 class="modal-title fs-5">录入供应商报价</h2><p class="mb-0 text-muted">记录供应商实际提供产品、参数、价格、交期和条款。</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">计划产品</label><select class="form-select" name="PlanItemId" required><option value="">请选择</option>@foreach(var item in plan.Items){<option value="@item.Id">@item.ProductName · @item.Quantity.ToString("0.###") @item.Unit</option>}</select></div><div class="col-md-6"><label class="form-label">供应商</label><select class="form-select" name="SupplierId" required><option value="">请选择</option>@foreach(var supplier in data.Suppliers.Where(x=>x.Status=="active")){<option value="@supplier.Id">@supplier.Name</option>}</select></div><div class="col-md-6"><label class="form-label">供应商提供产品</label><input class="form-control" name="OfferedProductName"></div><div class="col-md-2"><label class="form-label">长 cm</label><input class="form-control" name="LengthCm" type="number" min="0" step=".01"></div><div class="col-md-2"><label class="form-label">宽 cm</label><input class="form-control" name="WidthCm" type="number" min="0" step=".01"></div><div class="col-md-2"><label class="form-label">高 cm</label><input class="form-control" name="HeightCm" type="number" min="0" step=".01"></div><div class="col-md-3"><label class="form-label">重量 kg</label><input class="form-control" name="WeightKg" type="number" min="0" step=".001"></div><div class="col-md-3"><label class="form-label">颜色</label><input class="form-control" name="Color"></div><div class="col-md-3"><label class="form-label">尺寸说明</label><input class="form-control" name="SizeDetails"></div><div class="col-md-3"><label class="form-label">币种</label><select class="form-select" name="Currency"><option>CNY</option><option>USD</option></select></div><div class="col-md-4"><label class="form-label">单价</label><input class="form-control" name="UnitPrice" type="number" min="0" step=".0001"></div><div class="col-md-4"><label class="form-label">MOQ</label><input class="form-control" name="Moq" type="number" min="0" step=".001"></div><div class="col-md-4"><label class="form-label">交期/天</label><input class="form-control" name="LeadDays" type="number" min="0"></div><div class="col-md-4"><label class="form-label">有效日期</label><input class="form-control" name="ValidUntil" type="date"></div><div class="col-md-4"><label class="form-label">状态</label><select class="form-select" name="Status"><option value="draft">草稿</option><option value="sent">已询价</option><option value="quoted">已报价</option><option value="closed">已关闭</option></select></div><div class="col-md-4"><label class="form-label">条款</label><input class="form-control" name="Terms"></div><div class="col-12"><label class="form-label">参数详情</label><textarea class="form-control" name="ParameterDetails" rows="2"></textarea></div><div class="col-12"><label class="form-label">备注</label><textarea class="form-control" name="Notes" rows="2"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存报价</button></div></form></div></div></div>
 <div class="modal fade" id="sampleModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form asp-action="SavePlanSample" asp-route-planId="@plan.Id" method="post"><div class="modal-header"><div><h2 class="modal-title fs-5">添加样品记录</h2><p class="mb-0 text-muted">记录样品状态、费用与物流信息。</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">计划产品</label><select class="form-select" name="PlanItemId" required><option value="">请选择</option>@foreach(var item in plan.Items){<option value="@item.Id">@item.ProductName</option>}</select></div><div class="col-md-6"><label class="form-label">供应商（可选）</label><select class="form-select" name="SupplierId"><option value="">未指定</option>@foreach(var supplier in data.Suppliers.Where(x=>x.Status=="active")){<option value="@supplier.Id">@supplier.Name</option>}</select></div><div class="col-md-4"><label class="form-label">数量</label><input class="form-control" name="Quantity" type="number" min=".001" step=".001" value="1" required></div><div class="col-md-4"><label class="form-label">状态</label><select class="form-select" name="Status"><option value="requested">已申请</option><option value="received">已收到</option><option value="approved">已确认</option><option value="rejected">不合格</option></select></div><div class="col-md-4"><label class="form-label">成本 CNY</label><input class="form-control" name="CostCny" type="number" min="0" step=".01" value="0"></div><div class="col-md-6"><label class="form-label">物流单号</label><input class="form-control" name="TrackingNumber"></div><div class="col-md-6"><label class="form-label">说明</label><input class="form-control" name="Notes"></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存样品</button></div></form></div></div></div>
}
