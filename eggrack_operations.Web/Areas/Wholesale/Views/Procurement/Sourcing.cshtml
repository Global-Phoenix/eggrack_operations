@model eggrack_operations.Areas.Wholesale.Models.SourcingPageViewModel
@{ ViewData["Title"] = Model.InitialPlanNumber is null ? "寻源询价" : $"{Model.InitialPlanNumber} 详情"; }
<section class="proc" data-sourcing data-initial-plan-id="@Model.InitialPlanId" data-initial-plan-number="@Model.InitialPlanNumber" data-can-manage-costs="@Model.CanManageCosts.ToString().ToLowerInvariant()" data-can-submit-quote="@Model.CanSubmitQuote.ToString().ToLowerInvariant()" data-can-review-quote="@Model.CanReviewQuote.ToString().ToLowerInvariant()" data-can-final-approve="@Model.CanFinalApprove.ToString().ToLowerInvariant()" data-can-manage-pi="@Model.CanManagePi.ToString().ToLowerInvariant()" data-can-issue-pi="@Model.CanIssuePi.ToString().ToLowerInvariant()" data-can-send-mail="@Model.CanSendMail.ToString().ToLowerInvariant()">
@await Component.InvokeAsync("PageHeader", new { title = Model.InitialPlanNumber is null ? "寻源询价" : $"{Model.InitialPlanNumber} 详情", subtitle = "按采购计划完成供应商报价、样品文件、成本核算、审核与邮件任务", parentTitle = "批发管理", parentUrl = "/wholesale/procurement/sourcing" })
@if(Model.InitialPlanId is null)
{
 <div class="summary mb-3"><div class="tile">采购计划<b>@Model.Plans.Count</b></div><div class="tile">采购中<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.Sourcing)</b></div><div class="tile">部门审核<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.PendingApproval)</b></div><div class="tile">老板终审<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.PendingFinalApproval)</b></div><div class="tile">已批准<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.Approved)</b></div></div>
 <div class="panel overflow-hidden"><div class="tools"><input class="form-control" data-search placeholder="搜索计划、申请、客户或产品"><span class="ms-auto small text-secondary">共 @Model.Plans.Count 条计划</span></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>计划</th><th>申请/版本</th><th>客户</th><th>产品</th><th>采购人员</th><th>成本 CNY</th><th>报价 USD</th><th>状态</th><th></th></tr></thead><tbody>
 @foreach(var item in Model.Plans){<tr data-row><td><strong>@item.PlanNumber</strong></td><td>@item.RequestNumber <span class="proc-version-badge">V@(item.RequestVersion)</span></td><td>@item.CustomerName</td><td>@item.ProductSummary</td><td>@(item.BuyerName??"未分配")</td><td>@(Model.CanManageCosts ? item.TotalCostCny?.ToString("N2")??"—" : "无权限")</td><td>@(item.FinalQuoteUsd?.ToString("N2")??"—")</td><td><span class="stage">@item.Status</span></td><td><a class="btn btn-sm btn-outline-primary" href="/wholesale/procurement/plans/@item.Id/details">详情</a></td></tr>}
 @if(Model.Plans.Count==0){<tr><td colspan="9" class="text-center text-secondary py-5">暂无采购计划，请先在采购申请中创建。</td></tr>}
 </tbody></table></div></div>
}
else
{
 <div class="panel p-3 sourcing-workspace"><div class="d-flex align-items-center justify-content-between gap-3 mb-3"><div><h5 class="mb-1">@Model.InitialPlanNumber</h5><p class="small text-secondary mb-0">所有数据均关联当前采购计划。</p></div><a class="btn btn-sm btn-outline-secondary" href="/wholesale/procurement/sourcing"><i class="bi bi-arrow-left"></i> 返回计划列表</a></div><input type="hidden" data-plan-id>
 <section class="request-context mb-3" data-request-context><div class="text-secondary small">正在加载当前计划的申请版本信息…</div></section>
 <section class="section mt-0 mb-3 plan-product-editor"><div class="section-heading"><div><h6>内部采购计划产品</h6><p>客户申请仅作为参考；计划产品是独立数据，可引用后调整，也可完全自行录入。</p></div><button class="btn btn-sm btn-outline-primary" type="button" data-new-plan-item>新增计划产品</button></div>
  <div class="row g-3"><div class="col-lg-5"><label class="form-label">从申请产品引用（可选）</label><select class="form-select" data-request-source-items><option value="">不引用，手工录入</option></select><p class="form-text">引用只会预填表单，保存前可以修改全部内容。</p></div><div class="col-lg-7"><div data-plan-item-list></div></div></div>
  <form class="border rounded p-3 mt-3 bg-light" data-plan-item-form>@Html.AntiForgeryToken()<input type="hidden" name="Id"><input type="hidden" name="RequestItemId"><div class="row g-2"><div class="col-md-6"><label class="form-label">计划产品名称</label><input class="form-control" name="ProductName" required></div><div class="col-md-2"><label class="form-label">数量</label><input class="form-control" type="number" min="0.001" step="0.001" name="Quantity" required></div><div class="col-md-2"><label class="form-label">单位</label><input class="form-control" name="Unit" required></div><div class="col-md-2"><label class="form-label">SKU</label><input class="form-control" name="Sku"></div><div class="col-md-3"><label class="form-label">品牌</label><input class="form-control" name="Brand"></div><div class="col-md-3"><label class="form-label">规格</label><input class="form-control" name="Specifications"></div><div class="col-md-3"><label class="form-label">颜色</label><input class="form-control" name="Color"></div><div class="col-md-3"><label class="form-label">尺寸</label><input class="form-control" name="Size"></div><div class="col-md-6"><label class="form-label">产品描述</label><textarea class="form-control" rows="2" name="Description"></textarea></div><div class="col-md-3"><label class="form-label">包装要求</label><textarea class="form-control" rows="2" name="PackagingRequirements"></textarea></div><div class="col-md-3"><label class="form-label">定制要求</label><textarea class="form-control" rows="2" name="CustomizationRequirements"></textarea></div><div class="col-12"><label class="form-label">内部备注</label><input class="form-control" name="InternalNote"></div></div><div class="mt-3"><button class="btn btn-primary" type="submit">保存计划产品</button><button class="btn btn-outline-secondary ms-1" type="button" data-reset-plan-item>清空</button></div></form>
 </section>
 <ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#supplierPane">供应商报价</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#samplePane">样品与文件</button></li>@if(Model.CanManageCosts){<li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#costPane">成本核算</button></li>}<li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#approvalPane">报价审核与邮件</button></li></ul>
 <div class="tab-content">
  <div class="tab-pane fade show active" id="supplierPane">
   <div class="section mt-0"><div class="section-heading"><div><h6>计划供应商</h6><p>供应商档案与报价分开维护；页面集中展示与当前计划有关的数据。</p></div><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-secondary" href="/wholesale/procurement/suppliers">供应商目录</a><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#supplierEditorModal">新增供应商</button><button class="btn btn-sm btn-primary" type="button" data-new-inquiry>录入报价</button></div></div><div data-plan-suppliers></div></div>
   <div class="section"><div class="section-heading"><div><h6>供应商报价明细</h6><p>每个计划产品必须选择一条有效报价；修改报价会产生新版本，不覆盖历史。</p></div></div><div data-inquiries></div></div>
  </div>
  <div class="tab-pane fade" id="samplePane">
   <div class="section mt-0"><div class="section-heading"><div><h6>样品明细</h6><p>样品记录与附件分别维护，附件可关联到具体样品或整个计划。</p></div><button class="btn btn-sm btn-primary" type="button" data-new-sample>添加样品</button></div><div data-samples></div></div>
   <div class="section"><div class="section-heading"><div><h6>采购资料</h6><p>统一管理供应商报价、产品规格、推广资料、内部比价、样品及客户文件。</p></div><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#sampleFileModal">上传资料</button></div><div data-sample-files class="sample-file-grid"></div></div>
  </div>
  @if(Model.CanManageCosts){<div class="tab-pane fade" id="costPane"><div class="section mt-0"><div class="section-heading"><div><h6>成本核算</h6><p>产品成本自动来自各计划产品选中的供应商报价；下方只录入包装、物流、关税等公共费用。</p></div><button class="btn btn-sm btn-outline-primary" type="button" data-add-cost>添加公共费用</button></div><div class="mb-3" data-product-costs></div><form data-cost-form>@Html.AntiForgeryToken()<div data-cost-items></div><div class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">CNY/USD 汇率</label><input class="form-control" type="number" min="0.000001" step="0.000001" name="CnyPerUsd" value="7.12"></div><div class="col-md-4"><label class="form-label">目标利润率</label><input class="form-control" type="number" min="0.10" max="0.20" step="0.01" name="ProfitRate" value="0.15"></div></div><button class="btn btn-primary mt-3">保存成本草稿</button>@if(Model.CanSubmitQuote){<button class="btn btn-success mt-3 ms-2" type="button" data-submit-costs>提交部门审核</button>}<div class="alert alert-info d-none mt-3 mb-0" data-cost-result></div></form></div></div>}
  <div class="tab-pane fade" id="approvalPane"><div class="section mt-0"><h6>分级报价审核</h6><p class="small text-secondary">采购提交成本快照，部门负责人给出建议报价，老板完成最终定价。最终批准后成本和报价快照不可覆盖。</p><form data-approval-form>@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-3"><input class="form-control" type="number" min="4000.01" step="0.01" name="quoteUsd" placeholder="建议/最终报价 USD" required></div><div class="col-md-5"><input class="form-control" type="email" name="recipient" placeholder="客户收件人（最终批准时填写）"></div><div class="col-md-4"><input class="form-control" name="note" placeholder="审核意见或退回原因"></div></div><div class="mt-2">@if(Model.CanReviewQuote){<button class="btn btn-primary d-none" type="submit" data-decision="review">部门审核并推荐</button>} @if(Model.CanFinalApprove){<button class="btn btn-success d-none" type="submit" data-decision="approve">老板最终批准</button>} @if(Model.CanReviewQuote||Model.CanFinalApprove){<button class="btn btn-outline-danger d-none" type="submit" data-decision="reject">退回修改</button>}</div><div class="alert d-none mt-3" data-approval-result></div></form><h6 class="mt-4">审核记录</h6><div data-review-history class="text-secondary small">暂无审核记录。</div><div class="border rounded p-3 mt-4" data-pi-panel><h6>客户 PI</h6><div data-pi-summary class="text-secondary small">老板最终批准后自动生成 PI 快照。</div><form data-pi-pricing-form class="d-none mt-3">@Html.AntiForgeryToken()<input type="hidden" name="InvoiceId" data-pi-id><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>产品</th><th>数量</th><th>客户单价 USD</th><th>金额</th></tr></thead><tbody data-pi-items></tbody></table></div><div class="row g-2"><div class="col-md-3"><label class="form-label">包装费</label><input class="form-control" type="number" min="0" step="0.01" name="PackagingFee"></div><div class="col-md-3"><label class="form-label">运费</label><input class="form-control" type="number" min="0" step="0.01" name="ShippingFee"></div><div class="col-md-3"><label class="form-label">其他费用</label><input class="form-control" type="number" min="0" step="0.01" name="OtherFee"></div><div class="col-md-3"><label class="form-label">折扣</label><input class="form-control" type="number" min="0" step="0.01" name="DiscountAmount"></div></div><button class="btn btn-sm btn-outline-primary mt-2" type="submit">保存 PI 定价</button><span class="small text-secondary ms-2" data-pi-total></span></form><div class="mt-2"><button type="button" class="btn btn-sm btn-primary d-none" data-pi-action="issue">签发 PI</button> <button type="button" class="btn btn-sm btn-success d-none" data-pi-action="complete">完成采购计划</button></div></div><h6 class="mt-4">邮件任务</h6><div data-mail-tasks class="text-secondary">暂无邮件任务。</div></div></div>
 </div>
 <div class="modal fade" id="supplierEditorModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form data-quick-supplier-form>@Html.AntiForgeryToken()<div class="modal-header"><div><h5 class="modal-title">新增供应商档案</h5><p class="small text-secondary mb-0">建立一次，后续采购计划可重复选用。</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">供应商名称</label><input class="form-control" name="Name" required></div><div class="col-md-6"><label class="form-label">供应商编码</label><input class="form-control" name="Code"></div><div class="col-12"><label class="form-label">地址</label><input class="form-control" name="Address"></div><div class="col-md-6"><label class="form-label">法人</label><input class="form-control" name="LegalRepresentative"></div><div class="col-md-6"><label class="form-label">联系人</label><input class="form-control" name="ContactName"></div><div class="col-md-6"><label class="form-label">联系电话</label><input class="form-control" name="ContactPhone"></div><div class="col-md-6"><label class="form-label">网址</label><input class="form-control" type="url" name="Website" placeholder="https://"></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存供应商</button></div></form></div></div></div>
 <div class="modal fade" id="inquiryEditorModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><form data-inquiry-form>@Html.AntiForgeryToken()<input type="hidden" name="Id"><div class="modal-header"><div><h5 class="modal-title">供应商报价</h5><p class="small text-secondary mb-0">记录供应商实际提供产品，而非覆盖内部计划产品。</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">计划产品</label><select class="form-select" name="PlanItemId" data-plan-items required></select></div><div class="col-md-6"><label class="form-label">供应商</label><select class="form-select" name="SupplierId" data-suppliers-select required><option value="">选择供应商</option></select></div><div class="col-md-6"><label class="form-label">供应商提供产品</label><input class="form-control" name="OfferedProductName"></div><div class="col-md-2"><label class="form-label">长 cm</label><input class="form-control" type="number" min="0" step="0.001" name="LengthCm"></div><div class="col-md-2"><label class="form-label">宽 cm</label><input class="form-control" type="number" min="0" step="0.001" name="WidthCm"></div><div class="col-md-2"><label class="form-label">高 cm</label><input class="form-control" type="number" min="0" step="0.001" name="HeightCm"></div><div class="col-md-3"><label class="form-label">重量 kg</label><input class="form-control" type="number" min="0" step="0.001" name="WeightKg"></div><div class="col-md-3"><label class="form-label">颜色</label><input class="form-control" name="Color"></div><div class="col-md-6"><label class="form-label">尺寸说明</label><input class="form-control" name="SizeDetails"></div><div class="col-12"><label class="form-label">参数详情</label><textarea class="form-control" rows="2" name="ParameterDetails"></textarea></div><div class="col-md-2"><label class="form-label">货币</label><select class="form-select" name="Currency"><option>CNY</option><option>USD</option></select></div><div class="col-md-4"><label class="form-label">单价</label><input class="form-control" type="number" min="0" step="0.0001" name="UnitPrice"></div><div class="col-md-3"><label class="form-label">MOQ</label><input class="form-control" type="number" min="0" step="0.001" name="Moq"></div><div class="col-md-3"><label class="form-label">交期/天</label><input class="form-control" type="number" min="0" name="LeadDays"></div><div class="col-md-4"><label class="form-label">有效日期</label><input class="form-control" type="date" name="ValidUntil"></div><div class="col-md-4"><label class="form-label">状态</label><select class="form-select" name="Status"><option value="draft">草稿</option><option value="sent">已询价</option><option value="quoted">已报价</option><option value="closed">已关闭</option></select></div><div class="col-12"><label class="form-label">条款</label><textarea class="form-control" rows="2" name="Terms"></textarea></div><div class="col-12"><label class="form-label">备注</label><textarea class="form-control" rows="2" name="Notes"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存报价</button></div></form></div></div></div>
 <div class="modal fade" id="sampleEditorModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form data-sample-form>@Html.AntiForgeryToken()<input type="hidden" name="Id"><div class="modal-header"><h5 class="modal-title">样品记录</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">计划产品</label><select class="form-select" name="PlanItemId" data-plan-items required></select></div><div class="col-md-6"><label class="form-label">供应商</label><select class="form-select" name="SupplierId" data-suppliers-select><option value="">未指定供应商</option></select></div><div class="col-md-3"><label class="form-label">数量</label><input class="form-control" type="number" min="0.001" step="0.001" name="Quantity" value="1" required></div><div class="col-md-3"><label class="form-label">费用 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="CostCny" value="0" required></div><div class="col-md-6"><label class="form-label">状态</label><select class="form-select" name="Status"><option value="requested">已申请</option><option value="shipped">已发货</option><option value="received">已收样</option><option value="approved">已通过</option><option value="rejected">已拒绝</option></select></div><div class="col-12"><label class="form-label">物流/跟踪号</label><input class="form-control" name="TrackingNumber"></div><div class="col-12"><label class="form-label">备注</label><textarea class="form-control" rows="3" name="Notes"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存样品</button></div></form></div></div></div>
 <div class="modal fade" id="sampleFileModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form data-sample-file-form enctype="multipart/form-data">@Html.AntiForgeryToken()<div class="modal-header"><div><h5 class="modal-title">上传采购资料</h5><p class="small text-secondary mb-0">文件保存在运营系统受管目录，可按计划产品、供应商、报价或样品归档。</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">文件类型</label><select class="form-select" name="fileTypeId" data-file-types required><option value="">选择文件类型</option></select></div><div class="col-md-6"><label class="form-label">可见范围</label><select class="form-select" name="visibility"><option value="internal">仅内部</option><option value="supplier">可用于供应商沟通</option><option value="customer">可发送客户</option></select></div><div class="col-md-6"><label class="form-label">关联计划产品（可选）</label><select class="form-select" name="planItemId" data-plan-items><option value="">整个采购计划</option></select></div><div class="col-md-6"><label class="form-label">关联样品（可选）</label><select class="form-select" name="sampleId" data-sample-select><option value="">不关联样品</option></select></div><div class="col-md-6"><label class="form-label">关联供应商（可选）</label><select class="form-select" name="supplierId" data-suppliers-select><option value="">不关联供应商</option></select></div><div class="col-md-6"><label class="form-label">关联报价（可选）</label><select class="form-select" name="inquiryId" data-inquiry-select><option value="">不关联报价</option></select></div><div class="col-12"><label class="upload-dropzone" data-upload-dropzone><input type="file" name="file" required hidden><i class="bi bi-cloud-arrow-up"></i><strong>拖放文件到这里，或点击选择文件</strong><span data-upload-file-name>尚未选择文件</span></label></div><div class="col-12"><label class="form-label">文件说明（可选）</label><textarea class="form-control" rows="2" name="description" placeholder="说明文件用途、来源、日期或版本"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">上传资料</button></div></form></div></div></div>
 </div>
}
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-request-view.js" asp-append-version="true"></script><script src="~/js/pages/procurement-sourcing.js" asp-append-version="true"></script> }
