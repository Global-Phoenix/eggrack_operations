@model SourcingPageViewModel
@{
    ViewData["Title"]="采购计划";
    var active=Model.Plans.Count(item=>item.Status is ProcurementPlanStatus.Draft or ProcurementPlanStatus.Sourcing or ProcurementPlanStatus.Rejected);
    var pending=Model.Plans.Count(item=>item.Status is ProcurementPlanStatus.PendingApproval or ProcurementPlanStatus.PendingFinalApproval);
    var approved=Model.Plans.Count(item=>item.Status is ProcurementPlanStatus.Approved or ProcurementPlanStatus.EmailPending);
    var completed=Model.Plans.Count(item=>item.Status==ProcurementPlanStatus.Completed);
}
<section class="proc procurement-plan-list-page" data-procurement-plan-list>
@await Component.InvokeAsync("PageHeader",new{title="采购计划",subtitle="从计划详情完成产品采购、成本报价、最终确认、PI 与文件闭环。",parentTitle="批发管理",parentUrl="/wholesale/procurement/overview"})

<div class="summary mb-3">
 <div class="tile">全部计划<b>@Model.Plans.Count</b></div>
 <div class="tile">采购处理中<b>@active</b></div>
 <div class="tile">等待审批<b>@pending</b></div>
 <div class="tile">已确认报价<b>@approved</b></div>
</div>

<section class="ui-panel overflow-hidden">
 <div class="ui-toolbar">
  <label class="ui-toolbar-search"><i class="bi bi-search" aria-hidden="true"></i><input class="form-control" type="search" data-plan-search placeholder="搜索计划编号、申请编号、客户、产品或采购人员" aria-label="搜索采购计划"></label>
  <div class="status-filters" data-plan-filters>
   <button class="filter-pill active" type="button" data-status="">全部 <span>@Model.Plans.Count</span></button>
   <button class="filter-pill" type="button" data-status="active">采购中 <span>@active</span></button>
   <button class="filter-pill" type="button" data-status="pending">待审批 <span>@pending</span></button>
   <button class="filter-pill" type="button" data-status="approved">已确认 <span>@approved</span></button>
   <button class="filter-pill" type="button" data-status="completed">已完成 <span>@completed</span></button>
  </div>
 </div>
 <div class="ui-data-table">
  <table class="table table-hover align-middle mb-0">
   <thead><tr><th>计划</th><th>申请版本</th><th>客户 / 产品</th><th>采购人员</th><th>成本 CNY</th><th>报价 USD</th><th>状态</th><th class="text-end">操作</th></tr></thead>
   <tbody>
   @foreach(var item in Model.Plans)
   {
       var displayStatus=ProcurementUi.PlanStatus(item.Status);
       var filterStatus=item.Status switch
       {
           ProcurementPlanStatus.PendingApproval or ProcurementPlanStatus.PendingFinalApproval=>"pending",
           ProcurementPlanStatus.Approved or ProcurementPlanStatus.EmailPending=>"approved",
           ProcurementPlanStatus.Completed=>"completed",
           _=>"active"
       };
       <tr data-plan-row data-status="@filterStatus" data-search="@($"{item.PlanNumber} {item.RequestNumber} {item.CustomerName} {item.ProductSummary} {item.BuyerName}")">
        <td><strong>@item.PlanNumber</strong><small class="cell-subtitle">更新于 @ProcurementUi.RelativeTime(item.UpdatedAtUtc)</small></td>
        <td>@item.RequestNumber <span class="version-chip">V@(item.RequestVersion)</span></td>
        <td><strong>@item.CustomerName</strong><small class="cell-subtitle">@item.ProductSummary</small></td>
        <td>@(item.BuyerName??"未分配")</td>
        <td class="numeric">@(item.TotalCostCny?.ToString("N2")??"—")</td>
        <td class="numeric">@(item.FinalQuoteUsd?.ToString("N2")??"—")</td>
        <td><span class="ui-status ui-status-@displayStatus.Tone"><i></i>@displayStatus.Text</span></td>
        <td class="text-end">
         @if(item.Status==ProcurementPlanStatus.PendingFinalApproval&&Model.CanFinalApprove)
         {
          <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-planId="@item.Id" asp-fragment="cost">审核最终价格</a>
         }
         else if(item.Status==ProcurementPlanStatus.PendingApproval&&Model.CanReviewQuote)
         {
          <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-planId="@item.Id" asp-fragment="cost">部门审核</a>
         }
         else
         {
          <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-planId="@item.Id">进入计划</a>
         }
        </td>
       </tr>
   }
   @if(Model.Plans.Count>0)
   {
    <tr class="plan-list-empty-row" data-plan-empty hidden><td colspan="8">@await Component.InvokeAsync("EmptyState",new{title="没有符合条件的采购计划",description="请调整搜索内容或状态筛选后重试。",icon="bi-search"})</td></tr>
   }
   else
   {
    <tr class="plan-list-empty-row"><td colspan="8">@await Component.InvokeAsync("EmptyState",new{title="暂无采购计划",description="请先从客户采购申请创建内部采购计划。",icon="bi-clipboard2-check",actionText="前往采购申请",actionUrl=Url.Action("PurchaseRequests","Procurement",new{area="Wholesale"})})</td></tr>
   }
   </tbody>
  </table>
 </div>
</section>
</section>

@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-plans.js" asp-append-version="true"></script> }
