@model eggrack_operations.Areas.Wholesale.Models.SourcingPageViewModel
@{ ViewData["Title"] = Model.InitialPlanNumber is null ? "寻源询价" : $"{Model.InitialPlanNumber} 详情"; }
<section class="proc" data-sourcing data-initial-plan-id="@Model.InitialPlanId" data-initial-plan-number="@Model.InitialPlanNumber" data-can-manage-costs="@Model.CanManageCosts.ToString().ToLowerInvariant()">
@await Component.InvokeAsync("PageHeader", new { title = Model.InitialPlanNumber is null ? "寻源询价" : $"{Model.InitialPlanNumber} 详情", subtitle = "按采购计划完成供应商报价、样品文件、成本核算、审核与邮件任务", parentTitle = "批发管理", parentUrl = "/wholesale/procurement/sourcing" })
@if(Model.InitialPlanId is null)
{
 <div class="summary mb-3"><div class="tile">采购计划<b>@Model.Plans.Count</b></div><div class="tile">采购中<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.Sourcing)</b></div><div class="tile">待审核<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.PendingApproval)</b></div><div class="tile">已批准<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.Approved)</b></div></div>
 <div class="panel overflow-hidden"><div class="tools"><input class="form-control" data-search placeholder="搜索计划、申请、客户或产品"><span class="ms-auto small text-secondary">共 @Model.Plans.Count 条计划</span></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>计划</th><th>申请/版本</th><th>客户</th><th>产品</th><th>采购人员</th><th>成本 CNY</th><th>报价 USD</th><th>状态</th><th></th></tr></thead><tbody>
 @foreach(var item in Model.Plans){<tr data-row><td><strong>@item.PlanNumber</strong></td><td>@item.RequestNumber <span class="proc-version-badge">V@(item.RequestVersion)</span></td><td>@item.CustomerName</td><td>@item.ProductSummary</td><td>@(item.BuyerName??"未分配")</td><td>@(Model.CanManageCosts ? item.TotalCostCny?.ToString("N2")??"—" : "无权限")</td><td>@(item.FinalQuoteUsd?.ToString("N2")??"—")</td><td><span class="stage">@item.Status</span></td><td><a class="btn btn-sm btn-outline-primary" href="/wholesale/procurement/plans/@item.Id/details">详情</a></td></tr>}
 @if(Model.Plans.Count==0){<tr><td colspan="9" class="text-center text-secondary py-5">暂无采购计划，请先在采购申请中创建。</td></tr>}
 </tbody></table></div></div>
}
else
{
 <div class="panel p-3 sourcing-workspace"><div class="d-flex align-items-center justify-content-between gap-3 mb-3"><div><h5 class="mb-1">@Model.InitialPlanNumber</h5><p class="small text-secondary mb-0">所有数据均关联当前采购计划。</p></div><a class="btn btn-sm btn-outline-secondary" href="/wholesale/procurement/sourcing"><i class="bi bi-arrow-left"></i> 返回计划列表</a></div><input type="hidden" data-plan-id>
 <section class="request-context mb-3" data-request-context><div class="text-secondary small">正在加载当前计划的申请版本信息…</div></section>
 <ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#supplierPane">供应商报价</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#samplePane">样品与文件</button></li>@if(Model.CanManageCosts){<li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#costPane">成本核算</button></li>}<li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#approvalPane">报价审核与邮件</button></li></ul>
 <div class="tab-content">
  <div class="tab-pane fade show active" id="supplierPane">
   <div class="section mt-0"><div class="section-heading"><div><h6>供应商档案</h6><p>新增后自动加入本计划的报价供应商选择。</p></div><a class="btn btn-sm btn-link" href="/wholesale/procurement/suppliers">打开供应商目录</a></div>
    <form data-quick-supplier-form>@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-4"><label class="form-label">供应商名称</label><input class="form-control" name="Name" required></div><div class="col-md-2"><label class="form-label">供应商编码</label><input class="form-control" name="Code"></div><div class="col-md-6"><label class="form-label">地址</label><input class="form-control" name="Address"></div><div class="col-md-3"><label class="form-label">法人</label><input class="form-control" name="LegalRepresentative"></div><div class="col-md-3"><label class="form-label">联系人</label><input class="form-control" name="ContactName"></div><div class="col-md-3"><label class="form-label">联系电话</label><input class="form-control" name="ContactPhone"></div><div class="col-md-3"><label class="form-label">网址</label><input class="form-control" type="url" name="Website" placeholder="https://"></div></div><button class="btn btn-primary mt-3" type="submit">保存供应商</button></form>
   </div>
   <div class="section"><div class="section-heading"><div><h6>录入供应商报价</h6><p>记录供应商实际提供产品的参数、价格、交期和条款。</p></div></div>
    <form data-inquiry-form>@Html.AntiForgeryToken()<input type="hidden" name="Id"><div class="row g-2"><div class="col-md-6"><label class="form-label">计划产品</label><select class="form-select" name="PlanItemId" data-plan-items required></select></div><div class="col-md-6"><label class="form-label">供应商</label><select class="form-select" name="SupplierId" data-suppliers-select required><option value="">选择供应商</option></select></div><div class="col-md-6"><label class="form-label">供应商提供产品</label><input class="form-control" name="OfferedProductName"></div><div class="col-md-2"><label class="form-label">长 cm</label><input class="form-control" type="number" min="0" step="0.001" name="LengthCm"></div><div class="col-md-2"><label class="form-label">宽 cm</label><input class="form-control" type="number" min="0" step="0.001" name="WidthCm"></div><div class="col-md-2"><label class="form-label">高 cm</label><input class="form-control" type="number" min="0" step="0.001" name="HeightCm"></div><div class="col-md-3"><label class="form-label">重量 kg</label><input class="form-control" type="number" min="0" step="0.001" name="WeightKg"></div><div class="col-md-3"><label class="form-label">颜色</label><input class="form-control" name="Color"></div><div class="col-md-6"><label class="form-label">尺寸说明</label><input class="form-control" name="SizeDetails"></div><div class="col-12"><label class="form-label">参数详情</label><textarea class="form-control" rows="2" name="ParameterDetails"></textarea></div><div class="col-md-2"><label class="form-label">货币</label><select class="form-select" name="Currency"><option>CNY</option><option>USD</option></select></div><div class="col-md-4"><label class="form-label">单价</label><input class="form-control" type="number" min="0" step="0.0001" name="UnitPrice"></div><div class="col-md-3"><label class="form-label">MOQ</label><input class="form-control" type="number" min="0" step="0.001" name="Moq"></div><div class="col-md-3"><label class="form-label">交期/天</label><input class="form-control" type="number" min="0" name="LeadDays"></div><div class="col-md-4"><label class="form-label">有效日期</label><input class="form-control" type="date" name="ValidUntil"></div><div class="col-md-4"><label class="form-label">状态</label><select class="form-select" name="Status"><option value="draft">草稿</option><option value="sent">已询价</option><option value="quoted">已报价</option><option value="closed">已关闭</option></select></div><div class="col-12"><label class="form-label">条款</label><textarea class="form-control" rows="2" name="Terms"></textarea></div><div class="col-12"><label class="form-label">备注</label><textarea class="form-control" rows="2" name="Notes"></textarea></div></div><button class="btn btn-primary mt-3">保存报价</button></form>
   </div>
   <div class="section"><h6>本计划相关供应商</h6><div data-plan-suppliers></div><h6 class="mt-4">报价记录</h6><div data-inquiries></div></div>
  </div>
  <div class="tab-pane fade" id="samplePane">
   <div class="section mt-0"><h6>样品记录</h6><form data-sample-form>@Html.AntiForgeryToken()<input type="hidden" name="Id"><div class="row g-2"><div class="col-md-4"><select class="form-select" name="PlanItemId" data-plan-items required></select></div><div class="col-md-4"><select class="form-select" name="SupplierId" data-suppliers-select><option value="">未指定供应商</option></select></div><div class="col-md-2"><input class="form-control" type="number" min="0.001" step="0.001" name="Quantity" value="1" placeholder="数量"></div><div class="col-md-2"><input class="form-control" type="number" min="0" step="0.01" name="CostCny" value="0" placeholder="费用 CNY"></div><div class="col-md-4"><select class="form-select" name="Status"><option value="requested">已申请</option><option value="shipped">已发货</option><option value="received">已收样</option><option value="approved">已通过</option><option value="rejected">已拒绝</option></select></div><div class="col-md-4"><input class="form-control" name="TrackingNumber" placeholder="物流/跟踪号"></div><div class="col-md-4"><input class="form-control" name="Notes" placeholder="备注"></div></div><button class="btn btn-primary mt-2">保存样品</button></form><div data-samples class="mt-3"></div></div>
   <div class="section"><h6>上传样品文件</h6><form data-sample-file-form enctype="multipart/form-data">@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-4"><select class="form-select" name="sampleId" data-sample-select><option value="">关联整个采购计划</option></select></div><div class="col-md-5"><input class="form-control" type="file" name="file" required></div><div class="col-md-3"><button class="btn btn-primary w-100" type="submit">上传文件</button></div><div class="col-12"><input class="form-control" name="description" placeholder="文件说明（可选）"></div></div></form><div data-sample-files class="sample-file-grid mt-3"></div></div>
  </div>
  @if(Model.CanManageCosts){<div class="tab-pane fade" id="costPane"><div class="section mt-0"><div class="section-heading"><div><h6>成本核算</h6><p>成本名称可自定义，仅拥有采购成本权限的人员可查看和编辑。</p></div><button class="btn btn-sm btn-outline-primary" type="button" data-add-cost>添加成本项</button></div><form data-cost-form>@Html.AntiForgeryToken()<div data-cost-items></div><div class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">CNY/USD 汇率</label><input class="form-control" type="number" min="0.000001" step="0.000001" name="CnyPerUsd" value="7.12"></div><div class="col-md-4"><label class="form-label">利润率</label><input class="form-control" type="number" min="0.10" max="0.20" step="0.01" name="ProfitRate" value="0.15"></div></div><button class="btn btn-primary mt-3">保存并核算</button><div class="alert alert-info d-none mt-3 mb-0" data-cost-result></div></form></div></div>}
  <div class="tab-pane fade" id="approvalPane"><div class="section mt-0"><h6>报价审核与邮件任务</h6><form data-approval-form>@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-3"><input class="form-control" type="number" min="4000.01" step="0.01" name="quoteUsd" placeholder="最终报价 USD" required></div><div class="col-md-5"><input class="form-control" type="email" name="recipient" placeholder="收件人（批准时必填）"></div><div class="col-md-4"><input class="form-control" name="note" placeholder="审核备注/退回原因"></div></div><div class="mt-2"><button class="btn btn-success" type="submit" data-decision="approve">批准并创建邮件任务</button> <button class="btn btn-outline-danger" type="submit" data-decision="reject">退回</button></div><div class="alert d-none mt-3" data-approval-result></div></form><div class="border rounded p-3 mt-4" data-pi-panel><h6>客户 PI</h6><div data-pi-summary class="text-secondary small">批准报价后自动生成 PI 快照。</div><form data-pi-pricing-form class="d-none mt-3">@Html.AntiForgeryToken()<input type="hidden" name="InvoiceId" data-pi-id><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>产品</th><th>数量</th><th>客户单价 USD</th><th>金额</th></tr></thead><tbody data-pi-items></tbody></table></div><div class="row g-2"><div class="col-md-3"><label class="form-label">包装费</label><input class="form-control" type="number" min="0" step="0.01" name="PackagingFee"></div><div class="col-md-3"><label class="form-label">运费</label><input class="form-control" type="number" min="0" step="0.01" name="ShippingFee"></div><div class="col-md-3"><label class="form-label">其他费用</label><input class="form-control" type="number" min="0" step="0.01" name="OtherFee"></div><div class="col-md-3"><label class="form-label">折扣</label><input class="form-control" type="number" min="0" step="0.01" name="DiscountAmount"></div></div><button class="btn btn-sm btn-outline-primary mt-2" type="submit">保存 PI 定价</button><span class="small text-secondary ms-2" data-pi-total></span></form><div class="mt-2"><button type="button" class="btn btn-sm btn-primary d-none" data-pi-action="issue">签发 PI</button> <button type="button" class="btn btn-sm btn-success d-none" data-pi-action="complete">完成采购计划</button></div></div><h6 class="mt-4">邮件任务</h6><div data-mail-tasks class="text-secondary">暂无邮件任务。</div></div></div>
 </div></div>
}
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-request-view.js" asp-append-version="true"></script><script src="~/js/pages/procurement-sourcing.js" asp-append-version="true"></script> }
