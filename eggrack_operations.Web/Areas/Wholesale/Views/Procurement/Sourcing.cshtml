@model eggrack_operations.Areas.Wholesale.Models.SourcingPageViewModel
@{ ViewData["Title"] = Model.InitialPlanNumber is null ? "寻源询价" : $"{Model.InitialPlanNumber} 详情"; }
<section class="proc" data-sourcing data-initial-plan-id="@Model.InitialPlanId" data-initial-plan-number="@Model.InitialPlanNumber">
@await Component.InvokeAsync("PageHeader", new { title = "寻源询价", subtitle = "按采购计划完成供应商、产品匹配、询价、样品、成本核算、审核与邮件任务", parentTitle = "批发管理", parentUrl = "/" })
<div class="summary mb-3"><div class="tile">采购计划<b>@Model.Plans.Count</b></div><div class="tile">采购中<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.Sourcing)</b></div><div class="tile">待审核<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.PendingApproval)</b></div><div class="tile">已批准<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.Approved)</b></div></div>
<div class="panel overflow-hidden"><div class="tools"><input class="form-control" data-search placeholder="搜索计划、申请、客户或产品"><span class="ms-auto small text-secondary">共 @Model.Plans.Count 条计划</span></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>计划</th><th>申请/版本</th><th>客户</th><th>产品</th><th>采购人员</th><th>成本 CNY</th><th>报价 USD</th><th>状态</th><th></th></tr></thead><tbody>
@foreach(var item in Model.Plans){<tr data-row><td><strong>@item.PlanNumber</strong></td><td>@item.RequestNumber <span class="proc-version-badge">V@item.RequestVersion</span></td><td>@item.CustomerName</td><td>@item.ProductSummary</td><td>@(item.BuyerName??"未分配")</td><td>@(item.TotalCostCny?.ToString("N2")??"—")</td><td>@(item.FinalQuoteUsd?.ToString("N2")??"—")</td><td><span class="stage">@item.Status</span></td><td><a class="btn btn-sm btn-outline-primary" href="/wholesale/procurement/plans/@item.Id/details">详情</a></td></tr>}
@if(Model.Plans.Count==0){<tr><td colspan="9" class="text-center text-secondary py-5">暂无采购计划，请先在采购申请中创建。</td></tr>}
</tbody></table></div></div>
<div class="modal fade" id="sourcingModal" tabindex="-1" aria-labelledby="sourcingTitle"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><h5 class="modal-title" id="sourcingTitle">寻源询价</h5><p class="small text-secondary mb-0">所有数据均关联当前采购计划。</p></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" data-plan-id>
<ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#supplierPane">供应商与询价</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#samplePane">样品与文件</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#costPane">成本核算</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#approvalPane">报价审核与邮件</button></li></ul>
<div class="tab-content"><div class="tab-pane fade show active" id="supplierPane"><div class="row g-3"><div class="col-lg-6"><div class="section mt-0"><h6>候选产品与产品匹配</h6><form data-candidate-form>@Html.AntiForgeryToken()<input type="hidden" name="Id"><select class="form-select mb-2" name="PlanItemId" data-plan-items required></select><select class="form-select mb-2" name="SupplierId" data-suppliers-select><option value="">未匹配供应商</option></select><input class="form-control mb-2" name="ProductName" placeholder="候选产品名称" required><input class="form-control mb-2" name="ReferenceUrl" placeholder="参考链接"><textarea class="form-control mb-2" name="SpecificationJson" placeholder="规格 JSON"></textarea><select class="form-select mb-2" name="Status"><option value="candidate">候选</option><option value="matched">已匹配</option><option value="disabled">停用</option></select><button class="btn btn-primary">保存候选产品</button></form><div data-candidates class="mt-3"></div></div></div><div class="col-lg-6"><div class="section mt-0"><div class="d-flex align-items-center justify-content-between mb-2"><h6 class="mb-0">供应商询价</h6><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#quickSupplierForm">新增供应商</button></div><div class="collapse mb-3" id="quickSupplierForm"><form class="border rounded p-3 bg-light" data-quick-supplier-form>@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-7"><input class="form-control" name="Name" placeholder="供应商名称" required></div><div class="col-md-5"><input class="form-control" name="Code" placeholder="供应商编码"></div><div class="col-12"><textarea class="form-control" name="ContactJson" rows="2" placeholder='联系方式 JSON，例如 {"contact":"张三","mobile":"138..."}'></textarea></div></div><button class="btn btn-sm btn-primary mt-2" type="submit">保存并选择</button> <a class="btn btn-sm btn-link mt-2" href="/wholesale/procurement/suppliers">打开供应商目录</a></form></div><form data-inquiry-form>@Html.AntiForgeryToken()<input type="hidden" name="Id"><select class="form-select mb-2" name="PlanItemId" data-plan-items required></select><select class="form-select mb-2" name="SupplierId" data-suppliers-select required></select><div class="row g-2"><div class="col-4"><select class="form-select" name="Currency"><option>CNY</option><option>USD</option></select></div><div class="col-8"><input class="form-control" type="number" min="0" step="0.0001" name="UnitPrice" placeholder="单价"></div><div class="col-6"><input class="form-control" type="number" min="0" step="0.001" name="Moq" placeholder="MOQ"></div><div class="col-6"><input class="form-control" type="number" min="0" name="LeadDays" placeholder="交期/天"></div><div class="col-12"><input class="form-control" type="date" name="ValidUntil"></div></div><textarea class="form-control my-2" name="Terms" placeholder="条款"></textarea><textarea class="form-control mb-2" name="Notes" placeholder="备注"></textarea><select class="form-select mb-2" name="Status"><option value="draft">草稿</option><option value="sent">已询价</option><option value="quoted">已报价</option><option value="closed">已关闭</option></select><button class="btn btn-primary">保存询价</button></form><div data-inquiries class="mt-3"></div></div></div></div></div>
<div class="tab-pane fade" id="samplePane"><div class="section mt-0"><h6>样品与文件</h6><form data-sample-form>@Html.AntiForgeryToken()<input type="hidden" name="Id"><div class="row g-2"><div class="col-md-4"><select class="form-select" name="PlanItemId" data-plan-items required></select></div><div class="col-md-4"><select class="form-select" name="SupplierId" data-suppliers-select><option value="">未指定供应商</option></select></div><div class="col-md-2"><input class="form-control" type="number" min="0.001" step="0.001" name="Quantity" value="1" placeholder="数量"></div><div class="col-md-2"><input class="form-control" type="number" min="0" step="0.01" name="CostCny" value="0" placeholder="费用 CNY"></div><div class="col-md-4"><select class="form-select" name="Status"><option value="requested">已申请</option><option value="shipped">已发货</option><option value="received">已收样</option><option value="approved">已通过</option><option value="rejected">已拒绝</option></select></div><div class="col-md-4"><input class="form-control" name="TrackingNumber" placeholder="物流/跟踪号"></div><div class="col-md-4"><input class="form-control" name="Notes" placeholder="备注"></div></div><button class="btn btn-primary mt-2">保存样品</button> <a class="btn btn-outline-secondary mt-2" href="/files">打开文件中心</a></form><div data-samples class="mt-3"></div></div></div>
<div class="tab-pane fade" id="costPane"><div class="section mt-0"><h6>各项 CNY 成本与 CNY/USD 核算</h6><form data-cost-form>@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label>采购成本 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="PurchaseCostCny" value="0"></div><div class="col-md-4"><label>包装成本 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="PackagingCostCny" value="0"></div><div class="col-md-4"><label>样品成本 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="SampleCostCny" value="0"></div><div class="col-md-4"><label>国内运输 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="DomesticShippingCny" value="0"></div><div class="col-md-4"><label>国际运输 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="InternationalShippingCny" value="0"></div><div class="col-md-4"><label>其他成本 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="OtherCostCny" value="0"></div><div class="col-md-4"><label>CNY/USD 汇率</label><input class="form-control" type="number" min="0.000001" step="0.000001" name="CnyPerUsd" value="7.12"></div><div class="col-md-4"><label>利润率</label><input class="form-control" type="number" min="0.10" max="0.20" step="0.01" name="ProfitRate" value="0.15"></div></div><button class="btn btn-primary mt-3">保存并核算</button><div class="alert alert-info d-none mt-3 mb-0" data-cost-result></div></form></div></div>
<div class="tab-pane fade" id="approvalPane"><div class="section mt-0"><h6>报价审核与邮件任务</h6><form data-approval-form>@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-3"><input class="form-control" type="number" min="4000.01" step="0.01" name="quoteUsd" placeholder="最终报价 USD" required></div><div class="col-md-5"><input class="form-control" type="email" name="recipient" placeholder="收件人（批准时必填）"></div><div class="col-md-4"><input class="form-control" name="note" placeholder="审核备注/退回原因"></div></div><div class="mt-2"><button class="btn btn-success" type="submit" data-decision="approve">批准并创建邮件任务</button> <button class="btn btn-outline-danger" type="submit" data-decision="reject">退回</button></div><div class="alert d-none mt-3" data-approval-result></div></form><div class="border rounded p-3 mt-4" data-pi-panel><h6>客户 PI</h6><div data-pi-summary class="text-secondary small">批准报价后自动生成 PI 快照。</div><form data-pi-pricing-form class="d-none mt-3">@Html.AntiForgeryToken()<input type="hidden" name="InvoiceId" data-pi-id><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>产品</th><th>数量</th><th>客户单价 USD</th><th>金额</th></tr></thead><tbody data-pi-items></tbody></table></div><div class="row g-2"><div class="col-md-3"><label class="form-label">包装费</label><input class="form-control" type="number" min="0" step="0.01" name="PackagingFee"></div><div class="col-md-3"><label class="form-label">运费</label><input class="form-control" type="number" min="0" step="0.01" name="ShippingFee"></div><div class="col-md-3"><label class="form-label">其他费用</label><input class="form-control" type="number" min="0" step="0.01" name="OtherFee"></div><div class="col-md-3"><label class="form-label">折扣</label><input class="form-control" type="number" min="0" step="0.01" name="DiscountAmount"></div></div><button class="btn btn-sm btn-outline-primary mt-2" type="submit">保存 PI 定价</button><span class="small text-secondary ms-2" data-pi-total></span></form><div class="mt-2"><button type="button" class="btn btn-sm btn-primary d-none" data-pi-action="issue">签发 PI</button> <button type="button" class="btn btn-sm btn-success d-none" data-pi-action="complete">完成采购计划</button></div></div><h6 class="mt-4">邮件任务</h6><div data-mail-tasks class="text-secondary">暂无邮件任务。</div><p class="small text-secondary mt-2 mb-0">这里只创建任务记录，不直接发送邮件。</p></div></div></div>
</div></div></div></div>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-sourcing.js" asp-append-version="true"></script> }
