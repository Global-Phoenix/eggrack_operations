@model eggrack_operations.Areas.Wholesale.Models.SourcingPageViewModel
@{ ViewData["Title"] = "寻源询价"; }
<section class="proc" data-sourcing>
@await Component.InvokeAsync("PageHeader", new { title = "寻源询价", subtitle = "按采购计划完成供应商、产品匹配、询价、样品、成本核算、审核与邮件任务", parentTitle = "批发管理", parentUrl = "/" })
<div class="summary mb-3"><div class="tile">采购计划<b>@Model.Plans.Count</b></div><div class="tile">采购中<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.Sourcing)</b></div><div class="tile">待审核<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.PendingApproval)</b></div><div class="tile">已批准<b>@Model.Plans.Count(x=>x.Status==ProcurementPlanStatus.Approved)</b></div></div>
<div class="panel overflow-hidden"><div class="tools"><input class="form-control" data-search placeholder="搜索计划、申请、客户或产品"><span class="ms-auto small text-secondary">共 @Model.Plans.Count 条计划</span></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>计划</th><th>申请/版本</th><th>客户</th><th>产品</th><th>采购人员</th><th>成本 CNY</th><th>报价 USD</th><th>状态</th><th></th></tr></thead><tbody>
@foreach(var item in Model.Plans){<tr data-row><td><strong>@item.PlanNumber</strong></td><td>@item.RequestNumber <span class="proc-version-badge">V@item.RequestVersion</span></td><td>@item.CustomerName</td><td>@item.ProductSummary</td><td>@(item.BuyerName??"未分配")</td><td>@(item.TotalCostCny?.ToString("N2")??"—")</td><td>@(item.FinalQuoteUsd?.ToString("N2")??"—")</td><td><span class="stage">@item.Status</span></td><td><button class="btn btn-sm btn-outline-primary" data-open-plan data-plan-id="@item.Id" data-plan-number="@item.PlanNumber">办理</button></td></tr>}
@if(Model.Plans.Count==0){<tr><td colspan="9" class="text-center text-secondary py-5">暂无采购计划，请先在采购申请中创建。</td></tr>}
</tbody></table></div></div>
<div class="modal fade" id="sourcingModal" tabindex="-1" aria-labelledby="sourcingTitle"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><h5 class="modal-title" id="sourcingTitle">寻源询价</h5><p class="small text-secondary mb-0">所有数据均关联当前采购计划。</p></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" data-plan-id>
<ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#supplierPane">供应商与询价</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#samplePane">样品与文件</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#costPane">成本核算</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#approvalPane">报价审核与邮件</button></li></ul>
<div class="tab-content"><div class="tab-pane fade show active" id="supplierPane"><div class="section mt-0"><h6>现有供应商</h6><div data-suppliers class="text-secondary">打开计划后加载供应商…</div><p class="small text-secondary mt-3 mb-0">候选产品、产品匹配和询价记录将按计划明细维护，不使用演示数据。</p></div></div>
<div class="tab-pane fade" id="samplePane"><div class="section mt-0"><h6>样品与文件</h6><p class="text-secondary mb-0">样品记录使用采购样品表；附件统一关联文件中心。当前没有记录时保持空状态。</p></div></div>
<div class="tab-pane fade" id="costPane"><div class="section mt-0"><h6>各项 CNY 成本与 CNY/USD 核算</h6><form data-cost-form>@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label>采购成本 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="PurchaseCostCny" value="0"></div><div class="col-md-4"><label>包装成本 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="PackagingCostCny" value="0"></div><div class="col-md-4"><label>样品成本 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="SampleCostCny" value="0"></div><div class="col-md-4"><label>国内运输 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="DomesticShippingCny" value="0"></div><div class="col-md-4"><label>国际运输 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="InternationalShippingCny" value="0"></div><div class="col-md-4"><label>其他成本 CNY</label><input class="form-control" type="number" min="0" step="0.01" name="OtherCostCny" value="0"></div><div class="col-md-4"><label>CNY/USD 汇率</label><input class="form-control" type="number" min="0.000001" step="0.000001" name="CnyPerUsd" value="7.12"></div><div class="col-md-4"><label>利润率</label><input class="form-control" type="number" min="0.10" max="0.20" step="0.01" name="ProfitRate" value="0.15"></div></div><button class="btn btn-primary mt-3">保存并核算</button><div class="alert alert-info d-none mt-3 mb-0" data-cost-result></div></form></div></div>
<div class="tab-pane fade" id="approvalPane"><div class="section mt-0"><h6>报价审核与邮件任务</h6><p class="text-secondary mb-0">成本核算完成后进入报价审核；批准只创建待发送邮件任务，不在页面操作中直接外发邮件。</p></div></div></div>
</div></div></div></div>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-sourcing.js" asp-append-version="true"></script> }