@model eggrack_operations.Areas.Wholesale.Models.PurchaseRequestsPageViewModel
@{ ViewData["Title"] = "采购申请"; }
<section class="proc" data-purchase-requests>
@await Component.InvokeAsync("PageHeader", new { title = "采购申请", subtitle = "查看客户申请及版本，创建或更新唯一采购计划并分配采购人员", parentTitle = "批发管理", parentUrl = "/", primaryText = "创建采购计划", primaryModalTarget = "#planEditor" })
<div class="panel overflow-hidden">
 <div class="tools"><input class="form-control" type="search" data-search placeholder="搜索申请编号、客户或邮箱"><span class="ms-auto small text-secondary">共 @Model.Requests.Count 条申请</span></div>
 <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>申请编号</th><th>当前版本</th><th>客户</th><th>邮箱</th><th>提交时间</th><th>采购计划</th><th>采购人员</th><th class="text-end">操作</th></tr></thead><tbody>
 @foreach(var item in Model.Requests){<tr data-row><td><strong>@item.RequestNumber</strong></td><td><span class="proc-version-badge">V@(item.CurrentVersion)</span></td><td>@item.CustomerName</td><td>@item.Email</td><td>@item.SubmittedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@if(item.HasPlan){<span class="proc-plan-badge">@item.PlanNumber</span>}else{<span class="text-secondary">未创建</span>}</td><td>@(item.BuyerName??"未分配")</td><td class="text-end"><button class="btn btn-sm @(item.HasPlan?"btn-outline-primary":"btn-primary")" data-edit-plan data-request-id="@item.Id" data-version-id="@item.CurrentVersionId" data-plan-id="@item.PlanId" data-buyer-id="@item.BuyerId" data-number="@item.RequestNumber" data-customer="@item.CustomerName" data-email="@item.Email" data-submitted-at="@item.SubmittedAtUtc.ToString("O")" data-plan-number="@item.PlanNumber">@(item.HasPlan?"更新计划":"创建计划")</button></td></tr>}
 @if(Model.Requests.Count==0){<tr><td colspan="8" class="text-center text-secondary py-5">暂无采购申请</td></tr>}
 </tbody></table></div>
</div>
<div class="modal fade" id="planEditor" tabindex="-1" aria-labelledby="planEditorTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form data-plan-form>@Html.AntiForgeryToken()<div class="modal-header"><div><h5 class="modal-title" id="planEditorTitle">创建采购计划</h5><p class="small text-secondary mb-0" data-plan-caption>一个采购申请只对应一笔采购计划。</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="requestId" data-request-id><input type="hidden" data-plan-id>
<div class="request-overview mb-3"><div><small>申请编号</small><strong data-request-number>—</strong></div><div><small>客户</small><strong data-request-customer>—</strong></div><div><small>邮箱</small><strong data-request-email>—</strong></div><div><small>提交时间</small><strong data-request-submitted>—</strong></div><div><small>当前计划</small><strong data-request-plan>未创建</strong></div></div>
<div class="row g-3"><div class="col-md-6"><label class="form-label">申请版本</label><select class="form-select" name="requestVersionId" data-version required></select></div><div class="col-md-6"><label class="form-label">采购人员</label><select class="form-select" name="assignedBuyerStaffId" data-buyer required><option value="">请选择采购人员</option>@foreach(var buyer in Model.Buyers){<option value="@buyer.Id">@buyer.Name</option>}</select></div></div>
<div class="request-version-detail mt-3"><div class="d-flex justify-content-between align-items-center mb-2"><h6 class="mb-0">所选版本申请明细</h6><span class="small text-secondary" data-version-summary></span></div><div data-version-items class="text-secondary small">请选择申请版本。</div></div>
<div class="alert alert-danger d-none mt-3 mb-0" data-error></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit" data-submit>保存</button></div></form></div></div></div>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-requests.js" asp-append-version="true"></script> }
