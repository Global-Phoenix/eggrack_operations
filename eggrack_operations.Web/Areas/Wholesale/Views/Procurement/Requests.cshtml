@model eggrack_operations.Areas.Wholesale.Models.PurchaseRequestsPageViewModel
@{
    ViewData["Title"] = "采购申请";
    var firstUnplanned = Model.Requests.FirstOrDefault(item => !item.HasPlan);
    var createUrl = firstUnplanned is null
        ? null
        : Url.Action("CreatePlanPage", "Procurement", new { area = "Wholesale", requestId = firstUnplanned.Id });
}
<section class="proc" data-purchase-requests>
@await Component.InvokeAsync("PageHeader", new {
    title = "采购申请",
    subtitle = "客户申请仅作需求参考，在独立页面建立内部采购计划与可编辑产品明细",
    parentTitle = "批发管理",
    parentUrl = "/",
    primaryText = firstUnplanned is null ? null : "创建采购计划",
    primaryUrl = createUrl
})
<div class="panel overflow-hidden">
 <div class="tools"><input class="form-control" type="search" data-search placeholder="搜索申请编号、客户或邮箱"><span class="ms-auto small text-secondary">共 @Model.Requests.Count 条申请</span></div>
 <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>申请编号</th><th>当前版本</th><th>客户</th><th>邮箱</th><th>提交时间</th><th>采购计划</th><th>采购人员</th><th class="text-end">操作</th></tr></thead><tbody>
 @foreach(var item in Model.Requests)
 {
  var editorUrl = item.HasPlan
      ? Url.Action("EditPlanPage", "Procurement", new { area = "Wholesale", planId = item.PlanId })
      : Url.Action("CreatePlanPage", "Procurement", new { area = "Wholesale", requestId = item.Id });
  <tr data-row>
   <td><strong>@item.RequestNumber</strong></td>
   <td><span class="proc-version-badge">V@(item.CurrentVersion)</span></td>
   <td>@item.CustomerName</td><td>@item.Email</td>
   <td>@item.SubmittedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
   <td>@if(item.HasPlan){<span class="proc-plan-badge">@item.PlanNumber</span><div class="small text-secondary mt-1">@(item.PlanTitle??item.PlanNumber) · @(item.Priority switch { "low" => "低", "high" => "高", "urgent" => "紧急", _ => "普通" })</div>}else{<span class="text-secondary">未创建</span>}</td>
   <td>@(item.BuyerName??"未分配")</td>
   <td class="text-end"><a class="btn btn-sm @(item.HasPlan?"btn-outline-primary":"btn-primary")" href="@editorUrl">@(item.HasPlan?"更新计划":"创建计划")</a></td>
  </tr>
 }
 @if(Model.Requests.Count==0){<tr><td colspan="8" class="text-center text-secondary py-5">暂无采购申请</td></tr>}
 </tbody></table></div>
</div>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-requests.js" asp-append-version="true"></script> }
