@model PurchaseRequestsPageViewModel
@{ ViewData["Title"]="采购申请"; }
<section class="proc request-list-page" data-purchase-requests>
@await Component.InvokeAsync("PageHeader",new{title="采购申请",subtitle="管理客户提交的批发采购需求及版本更新。",parentTitle="批发管理",parentUrl="/wholesale/procurement/overview"})
<div class="ui-toolbar">
 <label class="ui-toolbar-search"><i class="bi bi-search" aria-hidden="true"></i><input class="form-control" type="search" data-search placeholder="搜索申请编号、客户或邮箱" aria-label="搜索采购申请"></label>
 <div class="status-filters" role="group" aria-label="按申请状态筛选">
  <button class="filter-pill active" type="button" data-status-filter="all">全部 <span>@Model.Requests.Count</span></button>
  <button class="filter-pill" type="button" data-status-filter="submitted">已提交 <span>@Model.Requests.Count(x=>x.RequestStatus==1)</span></button>
  <button class="filter-pill" type="button" data-status-filter="purchasing">采购中 <span>@Model.Requests.Count(x=>x.RequestStatus==2)</span></button>
  <button class="filter-pill" type="button" data-status-filter="quoted">已报价 <span>@Model.Requests.Count(x=>x.RequestStatus==3)</span></button>
  <button class="filter-pill" type="button" data-status-filter="completed">已完成 <span>@Model.Requests.Count(x=>x.RequestStatus==4)</span></button>
 </div>
 <div class="ui-toolbar-group">
  <label class="visually-hidden" for="requestSort">排序</label>
  <select class="form-select request-sort" id="requestSort" data-sort aria-label="采购申请排序"><option value="updated-desc">最近更新</option><option value="updated-asc">最早更新</option><option value="customer">客户名称</option><option value="request">申请编号</option></select>
 </div>
</div>
<div class="ui-data-table"><table class="table table-hover mb-0"><thead><tr><th>申请</th><th>客户</th><th class="numeric">产品</th><th>版本</th><th>状态</th><th>负责人</th><th>更新时间</th><th class="text-end">操作</th></tr></thead><tbody data-rows>
@foreach(var item in Model.Requests)
{
 var status=ProcurementUi.RequestStatus(item);
 var filterStatus=item.RequestStatus switch{2=>"purchasing",3=>"quoted",4=>"completed",_=>"submitted"};
 var detailUrl=Url.Action("RequestDetails","Procurement",new{area="Wholesale",requestId=item.Id});
 var planUrl=item.HasPlan
    ?Url.Action("Details","Procurement",new{area="Wholesale",planId=item.PlanId})
    :Url.Action("CreatePlanPage","Procurement",new{area="Wholesale",requestId=item.Id});
 var versionOutdated=item.HasPlan&&item.PlannedVersionId!=item.CurrentVersionId;
 <tr data-row data-status="@filterStatus" data-version-outdated="@versionOutdated.ToString().ToLowerInvariant()" data-updated="@item.UpdatedAtUtc.Ticks" data-customer="@item.CustomerName" data-request="@item.RequestNumber" data-href="@detailUrl" tabindex="0" aria-label="查看申请 @item.RequestNumber">
  <td><a class="row-title" href="@detailUrl">@item.RequestNumber</a>@if(versionOutdated){<small class="cell-attention"><i class="bi bi-exclamation-circle"></i> 客户已提交新版本</small>}else{<small class="ui-cell-secondary">首次提交 @ProcurementUi.RelativeTime(item.CreatedAtUtc)</small>}</td>
  <td><span class="ui-customer-name">@item.CustomerName</span><small class="ui-cell-secondary">@item.Email</small></td>
  <td class="numeric">@item.ProductCount</td>
  <td><span class="ui-version">V@(item.CurrentVersion)</span></td>
  <td><span class="er-status er-status-@status.Tone"><i></i>@status.Text</span></td>
  <td>@(item.BuyerName??"—")</td>
  <td><time title="@item.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@ProcurementUi.RelativeTime(item.UpdatedAtUtc)</time></td>
  <td class="text-end"><div class="request-row-actions">@if(item.HasPlan){<a class="btn btn-sm btn-outline-primary" href="@planUrl">进入计划</a>}else if(Model.CanCreatePlan){<a class="btn btn-sm btn-primary" href="@planUrl">创建计划</a>}else{<a class="request-detail-link" href="@detailUrl" aria-label="查看申请详情"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>}</div></td>
 </tr>
}
@if(Model.Requests.Count==0){<tr><td colspan="8">@await Component.InvokeAsync("EmptyState",new{title="暂无采购申请",description="客户提交申请后会显示在这里。",icon="bi-inbox"})</td></tr>}
</tbody></table></div>
<div class="ui-pagination"><span data-result-count>共 @Model.Requests.Count 条当前权限范围内的数据</span><span>显示最近 200 条申请</span></div>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-requests.js" asp-append-version="true"></script> }
