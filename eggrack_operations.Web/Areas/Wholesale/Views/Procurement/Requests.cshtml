@model eggrack_operations.Areas.Wholesale.Models.PurchaseRequestsPageViewModel
@{ ViewData["Title"] = "采购申请"; }
<section class="proc" data-purchase-requests>
@await Component.InvokeAsync("PageHeader", new { title = "采购申请", subtitle = "客户申请仅作需求参考，在此建立独立的内部采购计划与产品明细", parentTitle = "批发管理", parentUrl = "/", primaryText = "创建采购计划", primaryModalTarget = "#planEditor" })
<div class="panel overflow-hidden">
 <div class="tools"><input class="form-control" type="search" data-search placeholder="搜索申请编号、客户或邮箱"><span class="ms-auto small text-secondary">共 @Model.Requests.Count 条申请</span></div>
 <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>申请编号</th><th>当前版本</th><th>客户</th><th>邮箱</th><th>提交时间</th><th>采购计划</th><th>采购人员</th><th class="text-end">操作</th></tr></thead><tbody>
 @foreach(var item in Model.Requests){<tr data-row><td><strong>@item.RequestNumber</strong></td><td><span class="proc-version-badge">V@(item.CurrentVersion)</span></td><td>@item.CustomerName</td><td>@item.Email</td><td>@item.SubmittedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@if(item.HasPlan){<span class="proc-plan-badge">@item.PlanNumber</span><div class="small text-secondary mt-1">@(item.PlanTitle??item.PlanNumber) · @(item.Priority switch { "low" => "低", "high" => "高", "urgent" => "紧急", _ => "普通" })</div>}else{<span class="text-secondary">未创建</span>}</td><td>@(item.BuyerName??"未分配")</td><td class="text-end"><button class="btn btn-sm @(item.HasPlan?"btn-outline-primary":"btn-primary")" data-edit-plan data-request-id="@item.Id" data-version-id="@item.CurrentVersionId" data-plan-id="@item.PlanId" data-buyer-id="@item.BuyerId" data-number="@item.RequestNumber" data-customer="@item.CustomerName" data-email="@item.Email" data-submitted-at="@item.SubmittedAtUtc.ToString("O")" data-plan-number="@item.PlanNumber">@(item.HasPlan?"更新计划":"创建计划")</button></td></tr>}
 @if(Model.Requests.Count==0){<tr><td colspan="8" class="text-center text-secondary py-5">暂无采购申请</td></tr>}
 </tbody></table></div>
</div>
<div class="modal fade" id="planEditor" tabindex="-1" aria-labelledby="planEditorTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form data-plan-form>@Html.AntiForgeryToken()<div class="modal-header"><div><h5 class="modal-title" id="planEditorTitle">创建采购计划</h5><p class="small text-secondary mb-0" data-plan-caption>一个采购申请只对应一笔采购计划。</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="requestId" data-request-id><input type="hidden" data-plan-id>
<div class="request-overview mb-3"><div class="wide"><small>申请编号</small><strong data-request-number>—</strong></div><div><small>客户</small><strong data-request-customer>—</strong></div><div><small>邮箱</small><strong data-request-email>—</strong></div><div class="wide"><small>提交时间</small><strong data-request-submitted>—</strong></div><div class="wide"><small>当前计划</small><strong data-request-plan>未创建</strong></div></div>
<div class="plan-profile-card"><div class="section-heading"><div><h6>内部计划信息</h6><p>以下内容属于公司内部采购计划，不从客户申请自动生成。</p></div></div><div class="row g-3"><div class="col-md-8"><label class="form-label">计划名称</label><input class="form-control" name="PlanTitle" data-plan-title maxlength="200" placeholder="例如：北美客户 Q4 户外桌椅寻源计划" required></div><div class="col-md-4"><label class="form-label">优先级</label><select class="form-select" name="Priority" data-priority><option value="low">低</option><option value="normal" selected>普通</option><option value="high">高</option><option value="urgent">紧急</option></select></div><div class="col-md-4"><label class="form-label">采购人员</label><select class="form-select" name="AssignedBuyerStaffId" data-buyer required><option value="">请选择开发部采购人员</option>@foreach(var buyer in Model.Buyers){<option value="@buyer.Id">@buyer.Name</option>}</select></div><div class="col-md-4"><label class="form-label">计划开始日期</label><input class="form-control" type="date" name="PlannedStartDate" data-start-date></div><div class="col-md-4"><label class="form-label">目标完成日期</label><input class="form-control" type="date" name="TargetCompletionDate" data-target-date></div><div class="col-md-4"><label class="form-label">参考申请版本</label><select class="form-select" name="RequestVersionId" data-version required></select></div><div class="col-md-8"><label class="form-label">内部说明</label><textarea class="form-control" name="InternalNote" data-internal-note rows="2" placeholder="采购策略、交付要求、风险提示或内部协作说明"></textarea></div></div></div>
<div class="alert alert-info py-2 mt-3 mb-0 small"><i class="bi bi-info-circle me-1"></i>申请产品仅用于查看或预填。预填后形成独立计划产品，后续客户修改申请不会覆盖这里的数据。</div><div class="request-version-detail mt-3"><div class="d-flex justify-content-between align-items-center mb-2"><h6 class="mb-0">参考申请版本</h6><span class="small text-secondary" data-version-summary></span></div><div data-version-items class="text-secondary small">请选择申请版本。</div></div>
<div class="plan-products-editor mt-3"><div class="section-heading"><div><h6>内部计划产品</h6><p>至少录入一项；可从申请产品预填，也可完全手工录入。</p></div><button class="btn btn-sm btn-outline-primary" type="button" data-add-plan-item><i class="bi bi-plus-lg"></i> 手工新增</button></div><div class="input-group mb-3"><select class="form-select" data-reference-item><option value="">选择申请产品作为预填参考</option></select><button class="btn btn-outline-secondary" type="button" data-add-reference-item>预填到计划</button></div><div data-plan-items-editor></div></div>
<div class="alert alert-danger d-none mt-3 mb-0" data-error></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit" data-submit>保存</button></div></form></div></div></div>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-request-view.js" asp-append-version="true"></script><script src="~/js/pages/procurement-requests.js" asp-append-version="true"></script> }
