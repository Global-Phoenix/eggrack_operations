@model IReadOnlyList<ProcurementPlanListItem>
@{ ViewData["Title"] = "采购管理"; }
<section class="proc" data-proc>
@await Component.InvokeAsync("PageHeader", new { title = "采购开发计划", subtitle = "从客户采购申请建立计划，完成寻源、询价、核价与最终报价", parentTitle = "批发管理", parentUrl = "/wholesale/procurement", statusText = "运营工作台", statusTone = "warning", primaryText = "根据申请创建计划", primaryUrl = "#" })
<div class="summary mb-3"><div class="tile">进行中<b>@Model.Count</b></div><div class="tile">待分配<b>@Model.Count(x => x.Status == ProcurementPlanStatus.Draft)</b></div><div class="tile">待核价<b>@Model.Count(x => x.Status == ProcurementPlanStatus.Costing)</b></div><div class="tile">待老板审核<b>@Model.Count(x => x.Status == ProcurementPlanStatus.PendingApproval)</b></div></div><div class="proc-flow mb-3" aria-label="采购流程"><span class="active"><i class="bi bi-file-earmark-text"></i>申请建计划</span><i class="bi bi-chevron-right"></i><span><i class="bi bi-person-check"></i>人员分配</span><i class="bi bi-chevron-right"></i><span><i class="bi bi-search"></i>寻源询价</span><i class="bi bi-chevron-right"></i><span><i class="bi bi-calculator"></i>成本核算</span><i class="bi bi-chevron-right"></i><span><i class="bi bi-patch-check"></i>报价审核</span><i class="bi bi-chevron-right"></i><span><i class="bi bi-envelope"></i>邮件任务</span></div>
<div class="panel overflow-hidden"><div class="tools"><input class="form-control" data-search placeholder="搜索计划、申请、客户或产品"><select class="form-select w-auto" data-filter><option value="">全部状态</option><option>待分配</option><option>采购中</option><option>待核价</option><option>待老板审核</option></select><button class="btn btn-outline-secondary" type="button" data-reset><i class="bi bi-arrow-counterclockwise"></i> 重置</button><span class="ms-auto small text-secondary" data-result></span></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>计划</th><th>申请/版本</th><th>客户</th><th>产品</th><th>采购人员</th><th>成本/报价</th><th>状态</th><th></th></tr></thead><tbody>
@foreach(var item in Model){var label=item.Status switch{ProcurementPlanStatus.Draft=>"待分配",ProcurementPlanStatus.Sourcing=>"采购中",ProcurementPlanStatus.Costing=>"待核价",ProcurementPlanStatus.PendingApproval=>"待老板审核",ProcurementPlanStatus.Approved=>"已批准",_=>item.Status.ToString()};<tr data-row data-state="@label"><td><b>@item.PlanNumber</b></td><td>@item.RequestNumber <span class="badge text-bg-light">V@item.RequestVersion</span></td><td>@item.CustomerName</td><td>@item.ProductSummary</td><td>@(item.BuyerName??"未分配")</td><td>@(item.TotalCostCny is null?"—":item.TotalCostCny.Value.ToString("N2"))<br><small>@(item.FinalQuoteUsd is null?"—":item.FinalQuoteUsd.Value.ToString("N2"))</small></td><td><span class="stage">@label</span></td><td><button class="btn btn-sm btn-outline-secondary" data-open data-plan="@item.PlanNumber">打开</button></td></tr>}</tbody></table></div></div>
<div class="offcanvas offcanvas-end drawer" id="procurementDrawer" tabindex="-1"><div class="offcanvas-header border-bottom"><h5 data-title>采购计划</h5><button class="btn-close" data-bs-dismiss="offcanvas"></button></div><div class="offcanvas-body">
<div class="section"><h6>计划与人员分配</h6><div class="row g-2"><div class="col"><label class="form-label">申请版本</label><select class="form-select"><option>V3 · 最新</option><option>V2</option></select></div><div class="col"><label class="form-label">采购人员</label><select class="form-select"><option>王芳</option><option>刘洋</option><option>陈晨</option></select></div></div><button class="btn btn-warning mt-3">保存分配</button></div>
<div class="section"><h6>供应商、候选产品与询价</h6><div class="supplier"><div><b>深圳市海拓家居有限公司</b><br><small>现有供应商 · 已验厂 · ¥18.60</small></div><span class="score">92分</span><button class="btn btn-sm btn-outline-secondary ms-3">询价</button></div><div class="supplier"><div><b>宁波安居用品厂</b><br><small>候选产品 CP-183 · 可打样 · ¥19.20</small></div><span class="score">86分</span><button class="btn btn-sm btn-outline-secondary ms-3">询价</button></div><button class="btn btn-sm btn-outline-secondary mt-2">匹配供应商</button> <button class="btn btn-sm btn-outline-secondary mt-2">新建候选产品</button></div>
<div class="row"><div class="col-lg-8"><div class="section"><h6>成本核算</h6><form data-pricing>@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-4"><label>采购 CNY</label><input class="form-control" name="PurchaseCostCny" value="22320"></div><div class="col-md-4"><label>包装 CNY</label><input class="form-control" name="PackagingCostCny" value="1800"></div><div class="col-md-4"><label>样品 CNY</label><input class="form-control" name="SampleCostCny" value="480"></div><div class="col-md-4"><label>国内运输 CNY</label><input class="form-control" name="DomesticShippingCny" value="950"></div><div class="col-md-4"><label>国际运输 CNY</label><input class="form-control" name="InternationalShippingCny" value="6200"></div><div class="col-md-4"><label>其他 CNY</label><input class="form-control" name="OtherCostCny" value="300"></div><div class="col-md-4"><label>汇率</label><input class="form-control" name="CnyPerUsd" value="7.12"></div><div class="col-md-4"><label>利润率</label><input class="form-control" name="ProfitRate" value="0.15"></div></div><button class="btn btn-warning mt-3">计算报价</button></form><div class="money mt-3"><span>总成本 CNY</span><b data-cny>—</b></div><div class="money"><span>总成本 USD</span><b data-usd>—</b></div><div class="money"><span>建议报价 USD</span><b data-quote>—</b></div></div></div><div class="col-lg-4"><div class="section"><h6>样品与文件</h6><p>sample-front.jpg</p><p>supplier-quote.pdf</p><button class="btn btn-sm btn-outline-secondary">上传文件</button></div><div class="section"><h6>老板审核</h6><p class="text-secondary">利润率10%–20%，总金额大于 $4,000。</p><button class="btn btn-success">确认最终报价</button><p class="small text-secondary mt-2">批准后创建邮件任务。</p></div></div></div>
</div></div></section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts{<script>
(function(){var r=document.querySelector('[data-proc]'),d=bootstrap.Offcanvas.getOrCreateInstance('#procurementDrawer'),q=r.querySelector('[data-search]'),f=r.querySelector('[data-filter]');function x(){r.querySelectorAll('[data-row]').forEach(function(a){a.hidden=!(a.textContent.toLowerCase().includes(q.value.toLowerCase())&&(!f.value||a.dataset.state===f.value));});}q.oninput=x;f.onchange=x;r.querySelectorAll('[data-open]').forEach(function(b){b.onclick=function(){r.querySelector('[data-title]').textContent=b.dataset.plan;d.show();};});r.querySelector('[data-create]')?.addEventListener('click',function(){alert('请选择采购申请和版本');});r.querySelector('[data-pricing]').onsubmit=async function(e){e.preventDefault();var z=await fetch('/wholesale/procurement/pricing',{method:'POST',body:new FormData(e.target)}),j=await z.json();if(!z.ok)return alert(j.message);r.querySelector('[data-cny]').textContent='¥'+j.data.totalCostCny.toFixed(2);r.querySelector('[data-usd]').textContent='$'+j.data.totalCostUsd.toFixed(2);r.querySelector('[data-quote]').textContent='$'+j.data.suggestedQuoteUsd.toFixed(2);};})();
</script>}
