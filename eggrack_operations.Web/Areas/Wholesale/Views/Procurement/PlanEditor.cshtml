@model eggrack_operations.Areas.Wholesale.Models.ProcurementPlanEditorPageViewModel
@{
    var isUpdate = Model.Plan is not null;
    var pageTitle = isUpdate ? "更新采购计划" : "创建采购计划";
    var planTitle = Model.Request.RequestNumber;
    var saveUrl = isUpdate
        ? Url.Action("Update", "Procurement", new { area = "Wholesale", planId = Model.Plan!.Id })
        : Url.Action("Create", "Procurement", new { area = "Wholesale" });
}
<section class="proc proc-plan-editor-page"
         data-plan-editor-page
         data-request-id="@Model.Request.Id"
         data-plan-id="@Model.Plan?.Id"
         data-current-version-id="@(Model.Plan?.RequestVersionId ?? Model.Request.CurrentVersionId)">
@await Component.InvokeAsync("PageHeader", new {
    title = pageTitle,
    subtitle = isUpdate ? "维护内部采购计划，客户申请仅作为参考资料" : "基于客户采购申请创建内部采购计划",
    parentTitle = "采购申请",
    parentUrl = Url.Action("PurchaseRequests", "Procurement", new { area = "Wholesale" }),
    secondaryText = "返回申请",
    secondaryUrl = Url.Action("RequestDetails", "Procurement", new { area = "Wholesale", requestId = Model.Request.Id })
})

@if(TempData["Error"] is string serverError){<div class="alert alert-danger">@serverError</div>}

<form data-plan-form action="@saveUrl" method="post">
 @Html.AntiForgeryToken()
 <input type="hidden" name="requestId" value="@Model.Request.Id">
 <div class="plan-request-summary" aria-label="采购申请摘要">
  <div class="plan-request-summary-main">
   <span>申请</span>
   <strong>@Model.Request.RequestNumber</strong>
   <small><b data-request-customer>@Model.Request.CustomerName</b><i></i><span data-request-email>@Model.Request.Email</span></small>
  </div>
  <dl class="plan-request-summary-facts">
   <div><dt>版本</dt><dd data-summary-version>V@(Model.Request.CurrentVersion)</dd></div>
   <div><dt>产品</dt><dd data-summary-products>—</dd></div>
   <div><dt>附件</dt><dd data-summary-files>—</dd></div>
   <div><dt>提交</dt><dd data-request-submitted>@Model.Request.SubmittedAtUtc.ToLocalTime().ToString("MM/dd HH:mm")</dd></div>
   @if(isUpdate){<div><dt>计划</dt><dd>@Model.Plan!.PlanNumber</dd></div>}
  </dl>
 </div>

 <div class="plan-create-workspace">
  <section class="request-version-detail plan-reference-panel" aria-labelledby="request-reference-title">
   <header class="plan-workspace-header">
    <div><span class="plan-workspace-kicker">Requirement reference</span><h2 id="request-reference-title">客户申请</h2></div>
    <label class="plan-version-picker"><span>参考版本</span><select class="form-select form-select-sm" name="RequestVersionId" data-version required><option value="">正在加载…</option></select></label>
   </header>
   <div class="plan-reference-summary" data-version-summary>正在加载申请版本…</div>
   <div data-version-items class="text-secondary small">正在加载申请版本…</div>
  </section>

  <section class="plan-compose-panel" aria-labelledby="internal-plan-title">
   <header class="plan-workspace-header">
    <div><span class="plan-workspace-kicker">Internal purchase plan</span><h2 id="internal-plan-title">内部采购计划</h2></div>
    <span class="plan-independent-note"><i class="bi bi-shield-check"></i> 独立于客户申请保存</span>
   </header>
   <div class="plan-profile-card plan-settings-compact">
    <div class="plan-settings-heading"><h3>计划设置</h3><span>分配人员并补充内部协作说明</span></div>
    <div class="plan-settings-grid">
     <div class="plan-name-field"><label class="form-label">计划名称</label><input class="form-control system-field" value="@planTitle" readonly aria-readonly="true"></div>
     <div><label class="form-label">采购人员</label><select class="form-select" name="AssignedBuyerStaffId" data-buyer required><option value="">请选择采购人员</option>@foreach(var buyer in Model.Buyers){<option value="@buyer.Id">@buyer.Name</option>}</select></div>
     <div><label class="form-label">优先级</label><select class="form-select" name="Priority" data-priority><option value="low">低</option><option value="normal">普通</option><option value="high">高</option><option value="urgent">紧急</option></select></div>
     <div class="plan-note-field"><label class="form-label">计划说明 <span>选填</span></label><textarea class="form-control" name="InternalNote" data-internal-note rows="2" placeholder="采购策略、交付要求、风险或协作说明"></textarea></div>
    </div>
   </div>
   <div class="plan-products-editor">
    <div class="section-heading"><div><h3>内部计划产品</h3><p>可引用客户需求后修改，也可手工录入。</p></div><button class="btn btn-sm btn-outline-primary" type="button" data-add-plan-item><i class="bi bi-plus-lg"></i> 手工新增</button></div>
    <div class="input-group plan-reference-toolbar"><select class="form-select" data-reference-item><option value="">选择客户产品作为预填参考</option></select><button class="btn btn-outline-secondary" type="button" data-add-reference-item>预填产品</button></div>
    <div data-plan-items-editor></div>
   </div>
  </section>
 </div>

 <div class="alert alert-danger d-none mt-3 mb-0" data-error></div>
 <div class="editor-actions">
  <span><i class="bi bi-info-circle"></i> 客户申请仅作参考，计划产品创建后独立维护。</span>
  <div><a class="btn btn-outline-secondary" href="@Url.Action("RequestDetails", "Procurement", new { area = "Wholesale", requestId = Model.Request.Id })">取消</a><button class="btn btn-primary" type="submit" data-submit>@(isUpdate ? "保存计划" : "创建采购计划")</button></div>
 </div>
</form>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts {
 <script src="~/js/pages/procurement-request-view.js" asp-append-version="true"></script>
 <script src="~/js/pages/procurement-plan-editor.js" asp-append-version="true"></script>
}
