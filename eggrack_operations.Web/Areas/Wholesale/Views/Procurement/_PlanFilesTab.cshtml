@model PurchasePlanFilesTabViewModel
@{
 var plan=Model.Plan;
 var data=Model.Data;
 string Display(string? value)=>string.IsNullOrWhiteSpace(value)?"—":value;
}
@if(Model.CanManageFiles){
<section class="ui-panel p-4 mb-3"><div class="er-section-header"><div><h2>上传采购文件</h2><p>所有文件默认仅内部可见，上传后可单独授权客户查看。</p></div></div>
 <form asp-action="UploadPlanFile" asp-route-planId="@plan.Id" method="post" enctype="multipart/form-data" class="row g-3">
  <div class="col-lg-4"><label class="form-label">选择文件</label><input class="form-control" type="file" name="file" required></div>
  @if(data.FileTypes.Count>0){<div class="col-md-3 col-lg-2"><label class="form-label">文件类型</label><select class="form-select" name="fileTypeId" required>@foreach(var type in data.FileTypes){<option value="@type.Id">@type.Name</option>}</select><input type="hidden" name="fileType" value="other"></div>}else{<div class="col-md-3 col-lg-2"><label class="form-label">文件类型</label><select class="form-select" name="fileType"><option value="image">图片</option><option value="pdf">PDF</option><option value="video">视频</option><option value="specification">规格</option><option value="design">设计文件</option><option value="document">文档</option><option value="other">其他</option></select></div>}
  <div class="col-md-4 col-lg-3"><label class="form-label">关联产品（可选）</label><select class="form-select" name="planItemId"><option value="">计划级文件</option>@foreach(var item in plan.Items){<option value="@item.Id">@item.ProductName</option>}</select></div>
  <div class="col-md-5 col-lg-3"><label class="form-label">标题（可选）</label><input class="form-control" name="title"></div>
  <div class="col-md-4"><label class="form-label">关联供应商（可选）</label><select class="form-select" name="supplierId"><option value="">未关联</option>@foreach(var supplier in data.Suppliers){<option value="@supplier.Id">@supplier.Name</option>}</select></div>
  <div class="col-md-4"><label class="form-label">关联报价（可选）</label><select class="form-select" name="inquiryId"><option value="">未关联</option>@foreach(var inquiry in data.Inquiries){<option value="@inquiry.Id">@inquiry.ProductName · @inquiry.SupplierName · V@(inquiry.RevisionNo)</option>}</select></div>
  <div class="col-md-4"><label class="form-label">关联样品（可选）</label><select class="form-select" name="sampleId"><option value="">未关联</option>@foreach(var sample in data.Samples){<option value="@sample.Id">@sample.ProductName · @Display(sample.SupplierName)</option>}</select></div>
  <div class="col-12"><label class="form-label">文件说明（可选）</label><input class="form-control" name="description"></div>
  <div class="col-12"><button class="btn btn-primary" type="submit">上传文件</button></div>
 </form>
</section>}
<div class="plan-file-grid">
@foreach(var file in data.Files){var previewUrl=Url.Action("PlanFileContent",new{planId=plan.Id,fileId=file.Id});<article class="plan-file-card"><span class="plan-file-icon"><i class="bi @(file.MimeType.StartsWith("image/")?"bi-file-earmark-image":file.MimeType=="application/pdf"?"bi-file-earmark-pdf":file.MimeType.StartsWith("video/")?"bi-file-earmark-play":"bi-file-earmark-text")"></i></span><div><a href="@previewUrl" target="_blank" rel="noopener">@file.OriginalName</a><small>@file.FileType · @(file.FileSize/1024) KB · @Display(file.ProductName)</small><small>@Display(file.Description) · @file.UploadedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></div><div class="text-end"><span class="ui-status ui-status-@(file.IsCustomerVisible?"success":"neutral")"><i></i>@(file.IsCustomerVisible?"客户可见":"内部")</span>@if(Model.CanManageFiles){<form asp-action="SetPlanFileVisibility" asp-route-planId="@plan.Id" asp-route-fileId="@file.Id" method="post" class="mt-2"><input type="hidden" name="customerVisible" value="@(!file.IsCustomerVisible)"><button class="btn btn-sm btn-outline-secondary" type="submit">@(file.IsCustomerVisible?"取消客户可见":"设为客户可见")</button></form>}</div></article>}
@if(data.Files.Count==0){<div class="compact-empty"><i class="bi bi-folder2-open"></i><span>尚未上传采购计划文件。</span></div>}
</div>
