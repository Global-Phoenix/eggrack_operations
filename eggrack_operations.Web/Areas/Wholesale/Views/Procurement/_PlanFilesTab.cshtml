@model PurchasePlanFilesTabViewModel
@{
 var plan=Model.Plan;
 var data=Model.Data;
 string Display(string? value)=>string.IsNullOrWhiteSpace(value)?"—":value;
}
<div class="plan-tab-intro"><div><h2>采购文件</h2><p>文件按业务用途分类；产品、供应商、报价和样品通过关联字段表达，可见范围单独控制。</p></div></div>
@if(Model.CanManageFiles){
<section class="ui-panel plan-file-upload-panel mb-3"><div class="er-section-header"><div><h2>上传采购文件</h2><p>分类默认使用“产品资料”，客户可见默认关闭；标题为空时使用原文件名。</p></div></div>
 <form asp-action="UploadPlanFile" asp-route-planId="@plan.Id" method="post" enctype="multipart/form-data" class="plan-file-upload-form" data-plan-file-upload>
  <div class="plan-file-upload-basic">
   <div><label class="form-label">选择文件</label><input class="form-control" type="file" name="file" required></div>
   <div><label class="form-label">分类</label><select class="form-select" name="fileCategory" data-file-category required>@foreach(var category in ProcurementFileCategories.Options){<option value="@category.Code">@category.Name</option>}</select></div>
   <div><label class="form-label">关联产品（可选）</label><select class="form-select" name="planItemId"><option value="">未关联</option>@foreach(var item in plan.Items){<option value="@item.Id">@item.ProductName</option>}</select></div>
   <div><label class="form-label">标题（可选）</label><input class="form-control" name="title" placeholder="默认使用原文件名"></div>
   <label class="plan-file-visibility"><span>客户可见</span><input class="form-check-input" type="checkbox" role="switch" name="visibility" value="customer"><small>默认仅内部可见</small></label>
  </div>
  <details class="plan-file-more" data-file-more-relations>
   <summary>更多关联</summary>
   <div class="row g-3 pt-3">
    <div class="col-md-4" data-file-relation="supplier"><label class="form-label">关联供应商</label><select class="form-select" name="supplierId"><option value="">未关联</option>@foreach(var supplier in data.Suppliers){<option value="@supplier.Id">@supplier.Name</option>}</select></div>
    <div class="col-md-4" data-file-relation="inquiry"><label class="form-label">关联报价</label><select class="form-select" name="inquiryId"><option value="">未关联</option>@foreach(var inquiry in data.Inquiries){<option value="@inquiry.Id">@inquiry.ProductName · @inquiry.SupplierName · V@(inquiry.RevisionNo)</option>}</select></div>
    <div class="col-md-4" data-file-relation="sample"><label class="form-label">关联样品</label><select class="form-select" name="sampleId"><option value="">未关联</option>@foreach(var sample in data.Samples){<option value="@sample.Id">@sample.ProductName · @Display(sample.SupplierName)</option>}</select></div>
    <div class="col-12"><label class="form-label">文件说明（可选）</label><input class="form-control" name="description" placeholder="可填写版本、用途或补充说明"></div>
   </div>
  </details>
  <div class="plan-file-upload-actions"><button class="btn btn-primary" type="submit">上传文件</button></div>
 </form>
</section>}
<div class="plan-file-toolbar" data-plan-file-filters><div class="btn-group" role="group"><button class="btn btn-sm btn-primary active" type="button" data-file-filter="all">全部</button>@foreach(var category in ProcurementFileCategories.Options){<button class="btn btn-sm btn-outline-secondary" type="button" data-file-filter="@category.Code">@category.Name</button>}</div><select class="form-select form-select-sm" data-file-visibility-filter><option value="all">全部范围</option><option value="customer">客户可见</option><option value="internal">内部</option></select><select class="form-select form-select-sm" data-file-product-filter><option value="all">全部产品</option>@foreach(var item in plan.Items){<option value="@item.Id">@item.ProductName</option>}</select><span>@data.Files.Count 个文件</span></div>
<div class="plan-file-grid" data-plan-file-grid>
@foreach(var file in data.Files){var previewUrl=Url.Action("PlanFileContent",new{planId=plan.Id,fileId=file.Id});var category=ProcurementFileCategories.Normalize(file.FileType);var categoryName=ProcurementFileCategories.DisplayName(file.FileType);var displayTitle=string.IsNullOrWhiteSpace(file.Title)?file.OriginalName:file.Title;<article class="plan-file-card" data-plan-file-card data-file-category="@category" data-file-visibility="@(file.IsCustomerVisible?"customer":"internal")" data-plan-item="@(file.PlanItemId?.ToString()??"none")"><span class="plan-file-icon"><i class="bi @(file.MimeType.StartsWith("image/")?"bi-file-earmark-image":file.MimeType=="application/pdf"?"bi-file-earmark-pdf":file.MimeType.StartsWith("video/")?"bi-file-earmark-play":"bi-file-earmark-text")"></i></span><div><a href="@previewUrl" target="_blank" rel="noopener">@displayTitle</a><small>@categoryName · @(file.FileSize/1024) KB · @Display(file.ProductName)</small><small>@Display(file.Description) · @file.UploadedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></div><div class="text-end"><span class="ui-status ui-status-@(file.IsCustomerVisible?"success":"neutral")"><i></i>@(file.IsCustomerVisible?"客户可见":"内部")</span>@if(Model.CanManageFiles){<form asp-action="SetPlanFileVisibility" asp-route-planId="@plan.Id" asp-route-fileId="@file.Id" method="post" class="mt-2"><input type="hidden" name="customerVisible" value="@(!file.IsCustomerVisible)"><button class="btn btn-sm btn-outline-secondary" type="submit">@(file.IsCustomerVisible?"取消客户可见":"设为客户可见")</button></form>}</div></article>}
@if(data.Files.Count==0){<div class="compact-empty"><i class="bi bi-folder2-open"></i><span>尚未上传采购计划文件。</span></div>}
<div class="compact-empty d-none" data-plan-file-empty><i class="bi bi-funnel"></i><span>当前筛选条件下没有文件。</span></div>
</div>
