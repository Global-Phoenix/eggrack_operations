@model eggrack_operations.Areas.Wholesale.Models.SupplierDirectoryPageViewModel
@{ ViewData["Title"] = "供应商"; }
<section class="proc" data-supplier-directory>
@await Component.InvokeAsync("PageHeader", new { title = "供应商", subtitle = "查询采购询价使用的公司级供应商档案；新增供应商请从具体采购计划发起", parentTitle = "批发管理", parentUrl = "/wholesale/procurement/sourcing" })
<div class="panel overflow-hidden">
 <form class="tools" method="get" action="/wholesale/procurement/suppliers">
  <input class="form-control" type="search" name="keyword" value="@Model.Keyword" placeholder="搜索供应商名称、编码或联系方式">
  <button class="btn btn-outline-primary" type="submit">查询</button>
  <span class="ms-auto small text-secondary">共 @Model.Suppliers.Count 条</span>
 </form>
 <div class="table-responsive"><table class="table table-hover mb-0">
  <thead><tr><th>供应商</th><th>编码</th><th>地址</th><th>法人</th><th>联系人</th><th>电话</th><th>网址</th><th>状态</th><th>更新时间</th></tr></thead>
  <tbody>
  @foreach(var item in Model.Suppliers){<tr><td><strong>@item.Name</strong></td><td>@(item.Code??"—")</td><td>@(item.Address??"—")</td><td>@(item.LegalRepresentative??"—")</td><td>@(item.ContactName??"—")</td><td>@(item.ContactPhone??"—")</td><td>@if(item.Website is not null){<a href="@item.Website" target="_blank" rel="noopener">访问</a>}else{<span>—</span>}</td><td><span class="stage">@item.Status</span></td><td>@(item.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm")??"—")</td></tr>}
  @if(Model.Suppliers.Count==0){<tr><td colspan="9" class="text-center text-secondary py-5">没有匹配的供应商。</td></tr>}
  </tbody>
 </table></div>
</div>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
