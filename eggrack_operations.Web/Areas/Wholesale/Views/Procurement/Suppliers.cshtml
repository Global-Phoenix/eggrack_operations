@model eggrack_operations.Areas.Wholesale.Models.SupplierDirectoryPageViewModel
@{ ViewData["Title"] = "供应商"; }
<section class="proc" data-supplier-directory>
@await Component.InvokeAsync("PageHeader", new { title = "供应商", subtitle = "查询和维护采购询价使用的供应商资料", parentTitle = "批发管理", parentUrl = "/wholesale/procurement/sourcing" })
<div class="panel overflow-hidden">
 <form class="tools" method="get" action="/wholesale/procurement/suppliers">
  <input class="form-control" type="search" name="keyword" value="@Model.Keyword" placeholder="搜索供应商名称、编码或联系方式">
  <button class="btn btn-outline-primary" type="submit">查询</button>
  <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#supplierCreate">新增供应商</button>
  <span class="ms-auto small text-secondary">共 @Model.Suppliers.Count 条</span>
 </form>
 <div class="collapse border-bottom" id="supplierCreate">
  <form class="p-3" data-supplier-create-form>@Html.AntiForgeryToken()
   <div class="row g-2"><div class="col-md-4"><input class="form-control" name="Name" placeholder="供应商名称" required></div><div class="col-md-2"><input class="form-control" name="Code" placeholder="供应商编码"></div><div class="col-md-6"><input class="form-control" name="Address" placeholder="地址"></div><div class="col-md-3"><input class="form-control" name="LegalRepresentative" placeholder="法人"></div><div class="col-md-3"><input class="form-control" name="ContactName" placeholder="联系人"></div><div class="col-md-3"><input class="form-control" name="ContactPhone" placeholder="联系电话"></div><div class="col-md-3"><input class="form-control" type="url" name="Website" placeholder="网址 https://"></div></div>
   <button class="btn btn-primary mt-2" type="submit">保存供应商</button>
  </form>
 </div>
 <div class="table-responsive"><table class="table table-hover mb-0">
  <thead><tr><th>供应商</th><th>编码</th><th>地址</th><th>法人</th><th>联系人</th><th>电话</th><th>网址</th><th>状态</th><th>更新时间</th></tr></thead>
  <tbody>
  @foreach(var item in Model.Suppliers){<tr><td><strong>@item.Name</strong></td><td>@(item.Code??"—")</td><td>@(item.Address??"—")</td><td>@(item.LegalRepresentative??"—")</td><td>@(item.ContactName??"—")</td><td>@(item.ContactPhone??"—")</td><td>@if(item.Website is not null){<a href="@item.Website" target="_blank" rel="noopener">访问</a>}else{<span>—</span>}</td><td><span class="stage">@item.Status</span></td><td>@(item.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm")??"—")</td></tr>}
  @if(Model.Suppliers.Count==0){<tr><td colspan="9" class="text-center text-secondary py-5">没有匹配的供应商。</td></tr>}
  </tbody>
 </table></div>
</div>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/procurement-suppliers.js" asp-append-version="true"></script> }
