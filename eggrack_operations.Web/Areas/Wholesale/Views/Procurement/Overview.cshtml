@model WholesaleOverviewPageViewModel
@{
    ViewData["Title"]="批发概览";
    var newRequests=Model.Requests.Count(item=>!item.HasPlan);
    var purchasing=Model.Plans.Count(item=>item.Status is ProcurementPlanStatus.Draft or ProcurementPlanStatus.Sourcing);
    var review=Model.Plans.Count(item=>item.Status is ProcurementPlanStatus.PendingApproval or ProcurementPlanStatus.PendingFinalApproval);
    var completed=Model.Plans.Count(item=>item.Status==ProcurementPlanStatus.Completed);
    var attentionRequests=Model.Requests.Where(item=>!item.HasPlan).OrderByDescending(item=>item.SubmittedAtUtc).Take(5).ToArray();
    var myPlans=Model.Plans.Where(plan=>plan.Status!=ProcurementPlanStatus.Completed).OrderByDescending(plan=>plan.UpdatedAtUtc).Take(6).ToArray();
}
<section class="proc wholesale-overview">
@await Component.InvokeAsync("PageHeader",new{title="批发概览",subtitle="聚焦需要处理的申请、采购计划和最近业务进展。",parentTitle="批发管理",parentUrl="/wholesale/procurement/overview",primaryText=newRequests>0?"处理新申请":null,primaryUrl=newRequests>0?"/wholesale/procurement/requests":null})
<div class="ui-stat-grid">
 <a href="/wholesale/procurement/requests?status=submitted" class="ui-stat-card tone-info"><span class="ui-stat-icon"><i class="bi bi-file-earmark-text"></i></span><span class="ui-stat-copy"><strong>@newRequests</strong><b>新申请</b><small>等待建立采购计划</small></span><i class="bi bi-chevron-right"></i></a>
 <a href="/wholesale/procurement/sourcing" class="ui-stat-card tone-warning"><span class="ui-stat-icon"><i class="bi bi-cart3"></i></span><span class="ui-stat-copy"><strong>@purchasing</strong><b>采购中</b><small>草稿与寻源阶段</small></span><i class="bi bi-chevron-right"></i></a>
 <a href="/wholesale/procurement/sourcing" class="ui-stat-card tone-purple"><span class="ui-stat-icon"><i class="bi bi-shield-check"></i></span><span class="ui-stat-copy"><strong>@review</strong><b>审核中</b><small>部门或最终审核</small></span><i class="bi bi-chevron-right"></i></a>
 <a href="/wholesale/procurement/sourcing" class="ui-stat-card tone-success"><span class="ui-stat-icon"><i class="bi bi-check-circle"></i></span><span class="ui-stat-copy"><strong>@completed</strong><b>已完成</b><small>采购闭环完成</small></span><i class="bi bi-chevron-right"></i></a>
</div>
<div class="wholesale-overview-grid mt-3">
 <section class="er-section">
  <div class="er-section-header"><div><h2>需要关注</h2><p>尚未建立采购计划的客户申请</p></div><a href="/wholesale/procurement/requests">查看全部</a></div>
  <div class="attention-list">
   @foreach(var item in attentionRequests){<a href="/wholesale/procurement/requests/@item.Id/details"><span class="attention-icon"><i class="bi bi-file-earmark-plus"></i></span><span><strong>@item.RequestNumber</strong><small>@item.CustomerName · @item.ProductCount 项产品 · V@item.CurrentVersion</small></span><time>@item.SubmittedAtUtc.ToLocalTime().ToString("MM-dd HH:mm")</time><i class="bi bi-chevron-right"></i></a>}
   @if(attentionRequests.Length==0){<div class="compact-empty"><i class="bi bi-check2-circle"></i><span>所有申请都已建立采购计划。</span></div>}
  </div>
 </section>
 <section class="er-section">
  <div class="er-section-header"><div><h2>进行中的采购计划</h2><p>当前权限范围内最近更新的工作</p></div><a href="/wholesale/procurement/sourcing">查看全部</a></div>
  <div class="plan-compact-list">
   @foreach(var plan in myPlans){var status=ProcurementUi.PlanStatus(plan.Status);<a href="/wholesale/procurement/plans/@plan.Id/details"><span><strong>@plan.PlanNumber</strong><small>@plan.CustomerName · @(plan.BuyerName??"未分配")</small></span><span class="er-status er-status-@status.Tone"><i></i>@status.Text</span><time>@plan.UpdatedAtUtc.ToLocalTime().ToString("MM-dd HH:mm")</time><i class="bi bi-chevron-right"></i></a>}
   @if(myPlans.Length==0){<div class="compact-empty"><span>暂无进行中的采购计划。</span></div>}
  </div>
 </section>
</div>
</section>
@section Styles {
 <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
 <link rel="stylesheet" href="~/css/pages/procurement.css" asp-append-version="true" />
}
